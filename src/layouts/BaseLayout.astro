---
import { ClientRouter } from 'astro:transitions';
import TelemetryStrip from '../components/layout/TelemetryStrip.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { buildPersonSchema, buildProfilePageSchema } from '../lib/json-ld';

import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/fraunces';
import frauncesWoff2 from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';

import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  additionalSchemas?: Array<Record<string, unknown>>;
  noindex?: boolean;
  lang?: 'en' | 'id';
  ogType?: 'website' | 'article';
  keywords?: string[];
  preloadImage?: string;
  preloadImageSrcSet?: string;
  preloadImageSizes?: string;
  isProfilePage?: boolean;
}

const {
  title,
  description,
  ogImage = '/og/index.png',
  canonical: explicitCanonical,
  additionalSchemas = [],
  noindex = false,
  lang = 'id',
  ogType = 'website',
  keywords,
  preloadImage,
  preloadImageSrcSet,
  preloadImageSizes,
  isProfilePage,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const defaultCanonical = siteUrl ? `${siteUrl}${Astro.url.pathname}` : Astro.url.href;
const canonical = explicitCanonical || defaultCanonical;
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const isHome = isProfilePage ?? (Astro.url.pathname === '/' || Astro.url.pathname === '');
const rootSchema = isHome
  ? buildProfilePageSchema(siteUrl ? `${siteUrl}/` : undefined)
  : buildPersonSchema(siteUrl ? `${siteUrl}/` : undefined);
const allSchemas = [rootSchema, ...additionalSchemas];
const siteName = 'Wahyu Andika Putra';
const rssUrl = siteUrl ? `${siteUrl}/artikel/rss.xml` : '/artikel/rss.xml';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} - Artikel & Insights`} href={rssUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />
    <meta name="twitter:image:alt" content={title} />

    <meta name="theme-color" content="#0E0F13" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <meta name="application-name" content={siteName} />
    <meta name="format-detection" content="telephone=no" />
    <meta http-equiv="x-dns-prefetch-control" content="on" />
    <meta name="google-site-verification" content="Fos-Zmz6r5usOTK-AHOaKLUeebf2CWsIkI73WFVEaN8" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={frauncesWoff2} as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} imagesrcset={preloadImageSrcSet} imagesizes={preloadImageSizes} fetchpriority="high" />}

    <JsonLd schemas={allSchemas} />

    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('wahyu-theme'); } catch (e) {}
        var theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
        if (theme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        }
        document.documentElement.style.colorScheme = theme;
        document.documentElement.setAttribute('data-js-ready', '');
      })();
    </script>

    <script is:inline>
      (function () {
        function forceReveal() {
          var els = document.querySelectorAll('.js-reveal');
          for (var i = 0; i < els.length; i++) {
            els[i].style.opacity = '1';
            els[i].style.transform = 'none';
          }
        }
        window.addEventListener('load', function () {
          setTimeout(forceReveal, 2500);
        });
      })();
    </script>

    <ClientRouter />
  </head>
  <body id="top">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <TelemetryStrip />
    <Nav />
    <slot />
    <Footer />
  </body>
</html>

<script>
  import { initImageFallback } from '../scripts/image-fallback';

  document.addEventListener('astro:page-load', () => initImageFallback());
</script>

<style>
  .skip-link {
    position: absolute;
    top: -9999px;
    left: 1rem;
    z-index: 9999;
    padding: 0.5rem 1rem;
    background-color: var(--color-accent-phosphor);
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .skip-link:focus-visible {
    top: 1rem;
    outline: 2px solid var(--color-text-primary);
    outline-offset: 2px;
  }
</style>