---
import type { Project } from '../db/schema';
import BaseLayout from './BaseLayout.astro';
import ProjectDetailView from '../components/work/ProjectDetailView.astro';
import { buildProjectSchema } from '../lib/json-ld';

import { resolveCoverImage, resolveCoverImageSrcSet } from '../lib/cloudinary-url';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const ogImage = `/og/${project.slug}.png`;
const siteUrl = Astro.site?.toString() ?? 'https://wahyuandikaputra.my.id/';
const cleanSiteUrl = siteUrl.endsWith('/') ? siteUrl : `${siteUrl}/`;
const projectSchema = buildProjectSchema(project, cleanSiteUrl);
const canonicalUrl = `${cleanSiteUrl}work/${project.slug}/`;
const coverSrc = resolveCoverImage(project, 'f_auto,q_auto,w_1200');
const coverSrcSet = resolveCoverImageSrcSet(project, [480, 768, 1024, 1400], 'f_auto,q_auto');
---

<BaseLayout
  title={`${project.title} | Wahyu Andika Putra`}
  description={project.summary}
  canonical={canonicalUrl}
  ogImage={ogImage}
  additionalSchemas={[projectSchema]}
  lang="id"
  keywords={project.stack ?? []}
  preloadImage={coverSrc ?? undefined}
  preloadImageSrcSet={coverSrcSet ?? undefined}
>
  <main id="main-content">
    <ProjectDetailView project={project} />
  </main>
</BaseLayout>
