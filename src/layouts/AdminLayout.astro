---
import '../styles/global.css';
import AdminSidebar from '../components/admin/AdminSidebar.astro';
import { CSRF_COOKIE_NAME, CSRF_HEADER_NAME } from '../lib/csrf';

interface Props {
  title: string;
  breadcrumb?: string;
}

const { title, breadcrumb } = Astro.props;
const csrfToken = Astro.cookies.get(CSRF_COOKIE_NAME)?.value ?? '';
const hxHeaders = JSON.stringify({ [CSRF_HEADER_NAME]: csrfToken });
---

<!doctype html>
<html lang="en" data-theme="dark" class="bg-[#0f172a] text-slate-300 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Admin</title>
    <script is:inline src="/vendor/htmx-2.0.10.min.js" defer></script>
    <script is:inline src="/vendor/htmx-ext-json-enc.js" defer></script>
    <script is:inline src="/vendor/alpinejs-csp-3.15.12.min.js" defer></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js" defer></script>
  </head>
  <body x-data="{ sidebarOpen: false }" class="min-h-screen flex bg-[#0f172a] selection:bg-cyan-500/30 selection:text-cyan-100">
    <a href="#admin-main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-[100] px-4 py-2 bg-cyan-500 text-white rounded-lg">Lompat ke konten</a>

    <div id="admin-toast" role="status" aria-live="polite" data-state="hidden" data-variant="success" class="fixed bottom-4 right-4 z-50 transition-all duration-300 transform translate-y-full opacity-0"></div>

    <dialog id="confirm-dialog" class="backdrop:bg-black/60 bg-slate-900 border border-slate-700 p-6 rounded-xl shadow-2xl min-w-[320px] text-slate-200">
      <h3 class="text-lg font-semibold mb-2 text-white">Konfirmasi</h3>
      <p id="confirm-dialog-text" class="text-slate-400 mb-6"></p>
      <div class="flex justify-end gap-3">
        <button id="confirm-dialog-cancel" type="button" class="px-4 py-2 rounded-lg text-slate-300 hover:bg-slate-800 transition-colors">Batal</button>
        <button id="confirm-dialog-ok" type="button" class="px-4 py-2 rounded-lg bg-red-500/20 text-red-400 hover:bg-red-500 hover:text-white transition-colors border border-red-500/50">Konfirmasi</button>
      </div>
    </dialog>

    <AdminSidebar />

    <div class="flex-1 flex flex-col min-w-0 md:ml-64 transition-all duration-300 h-screen overflow-hidden relative">
      <!-- Decorative Gradient Overlay -->
      <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-cyan-500/50 to-transparent opacity-50 z-10 pointer-events-none"></div>
      <div class="absolute top-0 inset-x-0 h-32 bg-gradient-to-b from-cyan-900/10 to-transparent pointer-events-none z-0"></div>

      <!-- Topbar -->
      <header class="h-16 flex items-center justify-between px-6 border-b border-slate-800/60 bg-[#0f172a]/80 backdrop-blur-md sticky top-0 z-40">
        <div class="flex items-center gap-4">
          <button @click="sidebarOpen = true" class="md:hidden text-slate-400 hover:text-white">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </button>
          <div class="hidden sm:block">
            <nav class="flex text-sm font-medium text-slate-500" aria-label="Breadcrumb">
              <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <li class="inline-flex items-center">
                  <span class="text-slate-400 hover:text-cyan-400 transition-colors">WAP</span>
                </li>
                <li>
                  <div class="flex items-center">
                    <svg class="w-3 h-3 text-slate-600 mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    <span class="ml-1 text-slate-200">{breadcrumb ?? title}</span>
                  </div>
                </li>
              </ol>
            </nav>
          </div>
        </div>

        <div class="flex items-center gap-6">
          <!-- Search -->
          <div class="hidden md:flex relative group">
            <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-500 group-focus-within:text-cyan-400 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <input type="text" class="block w-64 p-2 pl-10 text-sm text-slate-200 bg-slate-900/50 border border-slate-700/80 rounded-lg focus:ring-cyan-500 focus:border-cyan-500 transition-colors placeholder-slate-500" placeholder="Cari..." />
            <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
              <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] font-mono text-slate-500 bg-slate-800 rounded border border-slate-700">⌘K</kbd>
            </div>
          </div>

          <!-- Notification -->
          <button class="relative text-slate-400 hover:text-cyan-400 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
            <span class="absolute top-0 right-0 block w-2 h-2 rounded-full bg-cyan-500 ring-2 ring-[#0f172a] shadow-[0_0_8px_rgba(6,182,212,0.8)]"></span>
          </button>

          <!-- User Profile -->
          <div class="flex items-center gap-3 pl-6 border-l border-slate-800 cursor-pointer group">
            <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-cyan-500 to-purple-500 p-[2px]">
              <div class="w-full h-full rounded-full bg-slate-900 border border-slate-900 overflow-hidden">
                <svg class="w-full h-full text-slate-500 mt-1" fill="currentColor" viewBox="0 0 24 24"><path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
              </div>
            </div>
            <div class="hidden lg:block text-sm">
              <div class="font-medium text-slate-200 group-hover:text-white transition-colors">Admin</div>
              <div class="text-xs text-slate-500">Superuser</div>
            </div>
          </div>
        </div>
      </header>

      <main id="admin-main" class="flex-1 overflow-y-auto p-4 md:p-8 scrollbar-thin scrollbar-thumb-slate-800 scrollbar-track-transparent z-10" hx-headers={hxHeaders}>
        <div class="max-w-7xl mx-auto space-y-8">
          <div class="flex items-center justify-between">
            <h1 class="text-2xl md:text-3xl font-display font-bold text-white tracking-tight">{title}</h1>
            <slot name="actions" />
          </div>
          <slot />
        </div>
      </main>
    </div>

    <!-- Mobile sidebar backdrop -->
    <div 
      x-show="sidebarOpen" 
      @click="sidebarOpen = false"
      x-transition:enter="transition-opacity ease-linear duration-300"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition-opacity ease-linear duration-300"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      class="fixed inset-0 bg-black/80 backdrop-blur-sm z-40 md:hidden"
      style="display: none;"
    ></div>

    <script>
      import { initAdminToast } from '../scripts/admin/htmx-toast';
      import { initConfirmDialog } from '../scripts/admin/confirm-dialog';

      initAdminToast();
      initConfirmDialog();
    </script>
  </body>
</html>
