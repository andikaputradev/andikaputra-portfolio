---
export interface Props {
  id: string;
  name: string;
  initialValue?: string;
  label?: string;
  required?: boolean;
  uploadFolder?: string;
  placeholder?: string;
  rows?: number;
}

const {
  id,
  name,
  initialValue = '',
  label,
  required = false,
  uploadFolder = 'portfolio/articles',
  placeholder = 'Tulis konten dalam format Markdown atau MDX...',
  rows = 16,
} = Astro.props;

const codeLanguages = [
  { value: 'typescript', label: 'TypeScript' },
  { value: 'javascript', label: 'JavaScript' },
  { value: 'bash', label: 'Bash / Shell' },
  { value: 'python', label: 'Python' },
  { value: 'html', label: 'HTML' },
  { value: 'css', label: 'CSS' },
  { value: 'json', label: 'JSON' },
  { value: 'sql', label: 'SQL' },
  { value: 'solidity', label: 'Solidity' },
  { value: 'rust', label: 'Rust' },
  { value: 'go', label: 'Go' },
  { value: 'text', label: 'Plain Text' },
];
---

<div class="markdown-editor js-markdown-editor w-full font-sans" data-upload-folder={uploadFolder}>
  {label && (
    <label for={id} class="block text-sm font-medium text-slate-300 mb-2">
      {label} {required && <span class="text-rose-400">*</span>}
    </label>
  )}

  <div class="rounded-xl border border-slate-800 bg-[#0f172a] shadow-2xl overflow-hidden focus-within:border-slate-700 transition-colors">
    <!-- Top Precision Toolbar -->
    <div
      role="toolbar"
      aria-label="Format dan perkakas dokumen Markdown"
      class="js-editor-toolbar flex flex-wrap items-center gap-1.5 p-2 bg-[#0f172a] border-b border-slate-800/80 text-slate-300 select-none"
    >
      <!-- Group 1: Undo / Redo -->
      <div role="group" aria-label="Riwayat riwayat pengetikan" class="flex items-center gap-0.5 pr-1.5 border-r border-slate-800">
        <button
          type="button"
          data-action="undo"
          aria-label="Undo tindakan sebelumnya (Ctrl+Z)"
          title="Undo (Ctrl+Z)"
          class="p-1.5 px-2 rounded-md text-xs font-mono font-medium text-slate-300 hover:bg-slate-800/80 hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
        >
          ↺
        </button>
        <button
          type="button"
          data-action="redo"
          aria-label="Redo tindakan berikutnya (Ctrl+Y)"
          title="Redo (Ctrl+Y)"
          class="p-1.5 px-2 rounded-md text-xs font-mono font-medium text-slate-300 hover:bg-slate-800/80 hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
        >
          ↻
        </button>
      </div>

      <!-- Group 2: Inline Formatting -->
      <div role="group" aria-label="Format sebaris" class="flex items-center gap-0.5 pr-1.5 border-r border-slate-800">
        <button
          type="button"
          data-action="bold"
          aria-label="Tebal (Ctrl+B)"
          title="Tebal (Ctrl+B)"
          class="p-1.5 px-2.5 rounded-md text-xs font-bold text-slate-300 hover:bg-slate-800/80 hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
        >
          B
        </button>
        <button
          type="button"
          data-action="italic"
          aria-label="Miring (Ctrl+I)"
          title="Miring (Ctrl+I)"
          class="p-1.5 px-2.5 rounded-md text-xs font-serif italic font-medium text-slate-300 hover:bg-slate-800/80 hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
        >
          I
        </button>
        <button
          type="button"
          data-action="strike"
          aria-label="Coretan (Strikethrough)"
          title="Coretan (Strikethrough)"
          class="p-1.5 px-2.5 rounded-md text-xs line-through text-slate-300 hover:bg-slate-800/80 hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
        >
          S
        </button>
        <button
          type="button"
          data-action="inline-code"
          aria-label="Kode sebaris"
          title="Kode sebaris"
          class="p-1.5 px-2 rounded-md text-xs font-mono text-cyan-400 bg-slate-900/60 border border-slate-800 hover:bg-slate-800 hover:text-cyan-300 transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
        >
          `code`
        </button>
      </div>

      <!-- Group 3: Headings -->
      <div role="group" aria-label="Tingkat Heading" class="flex items-center gap-0.5 pr-1.5 border-r border-slate-800">
        <button
          type="button"
          data-action="heading-2"
          aria-label="Heading tingkat 2"
          title="Heading level 2"
          class="p-1.5 px-2 rounded-md text-xs font-mono font-semibold text-slate-300 hover:bg-slate-800/80 hover:text-cyan-400 transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
        >
          H2
        </button>
        <button
          type="button"
          data-action="heading-3"
          aria-label="Heading tingkat 3"
          title="Heading level 3"
          class="p-1.5 px-2 rounded-md text-xs font-mono font-semibold text-slate-300 hover:bg-slate-800/80 hover:text-cyan-400 transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
        >
          H3
        </button>
        <button
          type="button"
          data-action="heading-4"
          aria-label="Heading tingkat 4"
          title="Heading level 4"
          class="p-1.5 px-2 rounded-md text-xs font-mono font-semibold text-slate-300 hover:bg-slate-800/80 hover:text-cyan-400 transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
        >
          H4
        </button>
      </div>

      <!-- Group 4: Lists & Blocks -->
      <div role="group" aria-label="Daftar dan blok" class="flex items-center gap-0.5 pr-1.5 border-r border-slate-800">
        <button
          type="button"
          data-action="bullet-list"
          aria-label="Daftar berbutir"
          title="Bullet list"
          class="p-1.5 px-2 rounded-md text-xs font-mono text-slate-300 hover:bg-slate-800/80 hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
        >
          • List
        </button>
        <button
          type="button"
          data-action="ordered-list"
          aria-label="Daftar bernomor"
          title="Ordered list"
          class="p-1.5 px-2 rounded-md text-xs font-mono text-slate-300 hover:bg-slate-800/80 hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
        >
          1. List
        </button>
        <button
          type="button"
          data-action="task-list"
          aria-label="Daftar tugas"
          title="Task list"
          class="p-1.5 px-2 rounded-md text-xs font-mono text-slate-300 hover:bg-slate-800/80 hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
        >
          [x]
        </button>
        <button
          type="button"
          data-action="quote"
          aria-label="Kutipan blockquote"
          title="Blockquote"
          class="p-1.5 px-2 rounded-md text-xs font-mono text-slate-300 hover:bg-slate-800/80 hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
        >
          Quote
        </button>

        <!-- Code block with language selector -->
        <div class="flex items-center bg-slate-900/90 border border-slate-800 rounded-md overflow-hidden ml-0.5">
          <button
            type="button"
            data-action="code-block"
            aria-label="Sisipkan blok kode (Ctrl+Shift+C)"
            title="Blok kode (Ctrl+Shift+C)"
            class="p-1.5 px-2 text-xs font-mono text-cyan-400 hover:bg-slate-800 hover:text-cyan-300 transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
          >
            &lt;/&gt; Block
          </button>
          <select
            aria-label="Pilih bahasa pemrograman"
            class="js-code-lang bg-slate-950 text-slate-300 text-[11px] font-mono py-1 px-1.5 border-l border-slate-800 focus:outline-none focus:ring-1 focus:ring-cyan-500 cursor-pointer"
          >
            {codeLanguages.map((lang) => (
              <option value={lang.value}>{lang.label}</option>
            ))}
          </select>
        </div>

        <button
          type="button"
          data-action="divider"
          aria-label="Garis pemisah horizontal"
          title="Horizontal Divider"
          class="p-1.5 px-2 rounded-md text-xs font-mono text-slate-300 hover:bg-slate-800/80 hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
        >
          ---
        </button>
      </div>

      <!-- Group 5: Rich Media & Tables -->
      <div role="group" aria-label="Media dan tabel" class="flex items-center gap-0.5 pr-1.5 border-r border-slate-800">
        <button
          type="button"
          data-action="link"
          aria-label="Sisipkan tautan (Ctrl+K)"
          title="Tautan (Ctrl+K)"
          class="p-1.5 px-2.5 rounded-md text-xs font-medium text-slate-300 hover:bg-slate-800/80 hover:text-cyan-400 transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
        >
          Link
        </button>
        <button
          type="button"
          data-action="image"
          aria-label="Sisipkan gambar"
          title="Gambar"
          class="p-1.5 px-2.5 rounded-md text-xs font-medium text-slate-300 hover:bg-slate-800/80 hover:text-cyan-400 transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
        >
          Image
        </button>
        <button
          type="button"
          data-action="table"
          aria-label="Sisipkan tabel GFM"
          title="Tabel Markdown"
          class="p-1.5 px-2.5 rounded-md text-xs font-medium text-slate-300 hover:bg-slate-800/80 hover:text-cyan-400 transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
        >
          Table
        </button>
      </div>

      <!-- Group 6: Custom MDX Components -->
      <div role="group" aria-label="Komponen MDX kustom" class="flex items-center gap-1 pr-1.5 border-r border-slate-800">
        <button
          type="button"
          data-action="mdx-callout"
          aria-label="Sisipkan komponen Callout MDX"
          title="Sisipkan Callout MDX"
          class="p-1.5 px-2 rounded-md text-xs font-mono font-medium text-cyan-400 bg-cyan-950/40 border border-cyan-800/60 hover:bg-cyan-900/60 hover:text-cyan-200 transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
        >
          + Callout
        </button>
        <button
          type="button"
          data-action="mdx-accordion"
          aria-label="Sisipkan komponen Accordion MDX"
          title="Sisipkan Accordion MDX"
          class="p-1.5 px-2 rounded-md text-xs font-mono font-medium text-indigo-400 bg-indigo-950/40 border border-indigo-800/60 hover:bg-indigo-900/60 hover:text-indigo-200 transition-colors focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:outline-none"
        >
          + Accordion
        </button>
      </div>

      <!-- Group 7: View Mode Toggle -->
      <div
        role="group"
        aria-label="Mode tampilan editor"
        class="ml-auto flex items-center gap-1 bg-slate-900/90 p-0.5 rounded-lg border border-slate-800"
      >
        <button
          type="button"
          data-view="write"
          aria-pressed="true"
          aria-label="Mode penulisan saja"
          class="px-2.5 py-1 rounded-md text-xs font-mono font-medium border border-transparent bg-slate-800 text-cyan-400 border-cyan-500/80 shadow-[0_0_10px_rgba(6,182,212,0.25)] transition-all focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
        >
          Write
        </button>
        <button
          type="button"
          data-view="split"
          aria-pressed="false"
          aria-label="Mode split layar (Editor & Pratinjau)"
          class="px-2.5 py-1 rounded-md text-xs font-mono font-medium border border-transparent text-slate-400 hover:text-slate-200 transition-all focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
        >
          Split
        </button>
        <button
          type="button"
          data-view="preview"
          aria-pressed="false"
          aria-label="Mode pratinjau penuh"
          class="px-2.5 py-1 rounded-md text-xs font-mono font-medium border border-transparent text-slate-400 hover:text-slate-200 transition-all focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
        >
          Preview
        </button>
      </div>
    </div>

    <!-- Main Workspace (Editor + Live Preview) -->
    <div class="js-editor-body-grid grid grid-cols-1 bg-[#0a0f1d] min-h-[22rem]">
      <!-- Column 1: Raw Markdown Editor -->
      <div class="js-editor-write-col flex flex-col min-h-[22rem]">
        <textarea
          id={id}
          name={name}
          required={required}
          rows={rows}
          placeholder={placeholder}
          aria-label={label || 'Isi konten dokumen'}
          class="js-editor-textarea w-full h-full min-h-[22rem] p-4 bg-transparent text-slate-100 font-mono text-sm leading-relaxed outline-none resize-y border-none focus:ring-0 placeholder:text-slate-600"
        >{initialValue}</textarea>
      </div>

      <!-- Column 2: Live HTML / MDX Preview -->
      <div class="js-editor-preview-col js-editor-preview-container hidden border-t lg:border-t-0 lg:border-l border-slate-800/80 bg-[#0b1120] min-h-[22rem] overflow-y-auto">
        <div class="p-3 border-b border-slate-800/60 bg-slate-900/60 flex items-center justify-between text-xs font-mono text-slate-400">
          <span>Pratinjau Layout Artikel (@tailwindcss/typography)</span>
          <span class="text-cyan-500 text-[11px] font-semibold tracking-wider uppercase">Live Render</span>
        </div>
        <div class="js-editor-preview-content prose prose-invert max-w-none p-6 text-slate-200">
          <p class="text-slate-500 italic">Belum ada konten untuk dipratinjau.</p>
        </div>
      </div>
    </div>

    <!-- Bottom Telemetry Status Strip -->
    <div
      role="status"
      aria-live="polite"
      class="flex flex-wrap items-center justify-between gap-2 px-4 py-2 bg-[#0a0f1d] border-t border-slate-800 text-xs font-mono text-slate-400 select-none"
    >
      <div class="flex items-center gap-4">
        <span class="js-telemetry-words flex items-center gap-1.5 text-slate-300 font-medium">
          0 kata
        </span>
        <span class="text-slate-700">|</span>
        <span class="js-telemetry-chars text-slate-400">
          0 karakter
        </span>
        <span class="text-slate-700">|</span>
        <span class="js-telemetry-reading text-cyan-400 font-medium">
          ~1 mnt baca
        </span>
      </div>

      <div class="flex items-center gap-3">
        <span class="js-telemetry-caret text-slate-400 font-mono">
          Ln 1, Col 1
        </span>
      </div>
    </div>
  </div>

  <!-- Modal 1: Accessible Link Modal -->
  <div
    role="dialog"
    aria-modal="true"
    aria-labelledby={`${id}-link-modal-title`}
    aria-hidden="true"
    class="js-link-modal fixed inset-0 z-50 flex items-center justify-center p-4 hidden"
  >
    <!-- Backdrop overlay -->
    <div class="js-modal-backdrop fixed inset-0 bg-black/75 backdrop-blur-xs transition-opacity"></div>

    <!-- Dialog Card -->
    <div class="relative w-full max-w-md bg-slate-900 border border-slate-800 rounded-xl p-6 shadow-2xl text-slate-200 z-10 focus:outline-none">
      <h3 id={`${id}-link-modal-title`} class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
        <span class="text-cyan-400 font-mono text-base">🔗</span> Sisipkan Tautan
      </h3>

      <div class="js-link-error text-xs text-rose-400 mb-3 min-h-[1rem]"></div>

      <div class="js-link-form space-y-4">
        <div>
          <label for={`${id}-link-text`} class="block text-xs font-medium text-slate-300 mb-1">
            Teks Ditampilkan
          </label>
          <input
            type="text"
            id={`${id}-link-text`}
            class="js-link-text w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500"
            placeholder="Misal: Baca Dokumentasi Lengkap"
          />
        </div>

        <div>
          <label for={`${id}-link-url`} class="block text-xs font-medium text-slate-300 mb-1">
            URL Tujuan <span class="text-rose-400">*</span>
          </label>
          <input
            type="text"
            id={`${id}-link-url`}
            required
            class="js-link-url w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 font-mono"
            placeholder="https://example.com atau /artikel/slug"
          />
        </div>

        <div class="flex items-center gap-2 pt-1">
          <input
            type="checkbox"
            id={`${id}-link-target`}
            class="js-link-target rounded border-slate-700 bg-slate-950 text-cyan-500 focus:ring-cyan-500 h-4 w-4"
          />
          <label for={`${id}-link-target`} class="text-xs text-slate-300 cursor-pointer">
            Buka di tab baru (<code>target="_blank"</code>)
          </label>
        </div>

        <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-800">
          <button
            type="button"
            class="js-link-cancel px-4 py-2 rounded-lg text-xs font-medium text-slate-300 hover:bg-slate-800 transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
          >
            Batal
          </button>
          <button
            type="button"
            class="js-link-submit-btn px-4 py-2 rounded-lg text-xs font-semibold bg-cyan-600 hover:bg-cyan-500 text-white transition-colors focus-visible:ring-2 focus-visible:ring-cyan-400 focus-visible:outline-none shadow-lg shadow-cyan-900/30"
          >
            Sisipkan Tautan
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal 2: Accessible Image Modal -->
  <div
    role="dialog"
    aria-modal="true"
    aria-labelledby={`${id}-image-modal-title`}
    aria-hidden="true"
    class="js-image-modal fixed inset-0 z-50 flex items-center justify-center p-4 hidden"
  >
    <!-- Backdrop overlay -->
    <div class="js-modal-backdrop fixed inset-0 bg-black/75 backdrop-blur-xs transition-opacity"></div>

    <!-- Dialog Card -->
    <div class="relative w-full max-w-lg bg-slate-900 border border-slate-800 rounded-xl p-6 shadow-2xl text-slate-200 z-10 focus:outline-none">
      <h3 id={`${id}-image-modal-title`} class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
        <span class="text-cyan-400 font-mono text-base">🖼️</span> Sisipkan Gambar
      </h3>

      <!-- Tabs Navigation -->
      <div role="tablist" aria-label="Metode sisipkan gambar" class="flex border-b border-slate-800 mb-4">
        <button
          type="button"
          role="tab"
          aria-selected="true"
          class="js-tab-url-btn px-4 py-2 text-xs font-medium border-b-2 border-cyan-500 text-cyan-400 focus:outline-none"
        >
          Direct URL
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          class="js-tab-upload-btn px-4 py-2 text-xs font-medium border-b-2 border-transparent text-slate-400 hover:text-slate-200 focus:outline-none"
        >
          Upload Gambar (Cloudinary)
        </button>
      </div>

      <!-- Tab Panel 1: Direct URL -->
      <div role="tabpanel" class="js-panel-url space-y-4">
        <div class="js-image-error text-xs text-rose-400 min-h-[1rem]"></div>
        <div class="js-image-url-form space-y-4">
          <div>
            <label for={`${id}-image-url-field`} class="block text-xs font-medium text-slate-300 mb-1">
              URL Gambar <span class="text-rose-400">*</span>
            </label>
            <input
              type="url"
              id={`${id}-image-url-field`}
              required
              class="js-image-url w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 font-mono"
              placeholder="https://res.cloudinary.com/.../image.webp"
            />
          </div>

          <div>
            <label for={`${id}-image-alt-field`} class="block text-xs font-medium text-slate-300 mb-1">
              Alt Text (SEO & Aksesibilitas) <span class="text-rose-400">*</span>
            </label>
            <input
              type="text"
              id={`${id}-image-alt-field`}
              required
              class="js-image-alt w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500"
              placeholder="Deskripsi spesifik tentang isi gambar"
            />
          </div>

          <div>
            <label for={`${id}-image-caption-field`} class="block text-xs font-medium text-slate-300 mb-1">
              Keterangan Gambar (Opsional)
            </label>
            <input
              type="text"
              id={`${id}-image-caption-field`}
              class="js-image-caption w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500"
              placeholder="Caption di bawah gambar"
            />
          </div>

          <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-800">
            <button
              type="button"
              class="js-image-cancel px-4 py-2 rounded-lg text-xs font-medium text-slate-300 hover:bg-slate-800 transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
            >
              Batal
            </button>
            <button
              type="button"
              class="js-image-url-submit-btn px-4 py-2 rounded-lg text-xs font-semibold bg-cyan-600 hover:bg-cyan-500 text-white transition-colors focus-visible:ring-2 focus-visible:ring-cyan-400 focus-visible:outline-none shadow-lg shadow-cyan-900/30"
            >
              Sisipkan Gambar
            </button>
          </div>
        </div>
      </div>

      <!-- Tab Panel 2: Cloudinary Upload -->
      <div role="tabpanel" class="js-panel-upload space-y-4 hidden">
        <div class="js-image-upload-error text-xs text-rose-400 min-h-[1rem]"></div>
        <div class="js-image-upload-form space-y-4">
          <!-- File Dropzone -->
          <div
            tabindex="0"
            role="button"
            aria-label="Klik atau seret gambar ke sini untuk upload"
            class="js-dropzone border-2 border-dashed border-slate-700 hover:border-cyan-500 rounded-xl p-6 text-center cursor-pointer transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
          >
            <input type="file" accept="image/*" class="js-file-input hidden" />
            <div class="text-2xl mb-2">☁️</div>
            <p class="text-sm font-medium text-slate-200">
              Seret dan lepaskan gambar ke sini, atau klik untuk memilih
            </p>
            <p class="text-xs text-slate-400 mt-1">
              Format yang didukung: PNG, JPEG, WebP, SVG (Maks. 5MB)
            </p>
            <div class="js-upload-status text-xs text-cyan-400 font-mono mt-3 min-h-[1.25rem]"></div>
          </div>

          <div>
            <label for={`${id}-upload-alt-field`} class="block text-xs font-medium text-slate-300 mb-1">
              Alt Text (SEO & Aksesibilitas) <span class="text-rose-400">*</span>
            </label>
            <input
              type="text"
              id={`${id}-upload-alt-field`}
              required
              class="js-image-alt w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500"
              placeholder="Deskripsi gambar untuk pembaca layar & Google Image"
            />
          </div>

          <div>
            <label for={`${id}-upload-caption-field`} class="block text-xs font-medium text-slate-300 mb-1">
              Keterangan Gambar (Opsional)
            </label>
            <input
              type="text"
              id={`${id}-upload-caption-field`}
              class="js-image-caption w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500"
              placeholder="Caption di bawah gambar"
            />
          </div>

          <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-800">
            <button
              type="button"
              class="js-image-cancel px-4 py-2 rounded-lg text-xs font-medium text-slate-300 hover:bg-slate-800 transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:outline-none"
            >
              Batal
            </button>
            <button
              type="button"
              class="js-image-upload-submit-btn px-4 py-2 rounded-lg text-xs font-semibold bg-cyan-600 hover:bg-cyan-500 disabled:opacity-50 text-white transition-colors focus-visible:ring-2 focus-visible:ring-cyan-400 focus-visible:outline-none shadow-lg shadow-cyan-900/30"
            >
              Upload & Sisipkan
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { initAllMarkdownEditors } from '../../scripts/admin/markdown-editor';

  // Inisialisasi editor setelah DOM siap
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initAllMarkdownEditors();
    });
  } else {
    initAllMarkdownEditors();
  }
</script>
