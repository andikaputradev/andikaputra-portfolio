---
export interface Props {
  label: string;
  value: string | number;
  suffix?: string;
  trend?: number;
  icon?: string;
  color?: 'cyan' | 'purple' | 'green' | 'orange';
}

const { label, value, suffix, trend, icon, color = 'cyan' } = Astro.props;

const colorMap = {
  cyan: 'text-cyan-400 bg-cyan-400/10 border-cyan-400/20 shadow-cyan-500/10',
  purple: 'text-purple-400 bg-purple-400/10 border-purple-400/20 shadow-purple-500/10',
  green: 'text-green-400 bg-green-400/10 border-green-400/20 shadow-green-500/10',
  orange: 'text-orange-400 bg-orange-400/10 border-orange-400/20 shadow-orange-500/10',
};

const bgClass = colorMap[color];
---

<div class="relative group p-6 rounded-2xl bg-slate-900 border border-slate-800 shadow-xl overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:border-slate-700">
  <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
  
  <div class="flex items-start justify-between relative z-10">
    <div>
      <p class="text-sm font-medium text-slate-400 mb-2">{label}</p>
      <h3 class="text-3xl font-display font-bold text-white tracking-tight">{value}{suffix && <span class="text-sm font-normal text-slate-400 ml-1">{suffix}</span>}</h3>
    </div>
    
    <div class={`w-12 h-12 rounded-xl flex items-center justify-center border shadow-lg ${bgClass}`}>
      {icon ? (
        <Fragment set:html={icon} />
      ) : (
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
      )}
    </div>
  </div>

  {trend !== undefined && (
    <div class="mt-4 flex items-center gap-2 relative z-10 text-sm">
      <span class={`flex items-center gap-1 font-medium ${trend >= 0 ? 'text-green-400' : 'text-red-400'}`}>
        {trend >= 0 ? (
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
        ) : (
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0v-8m0 8l-8-8-4 4-6-6"></path></svg>
        )}
        {Math.abs(trend)}%
      </span>
      <span class="text-slate-500">vs last week</span>
    </div>
  )}
</div>
