---
import '../../styles/admin-forms.css';
import type { Article } from '../../db/schema';
import MarkdownEditor from './MarkdownEditor.astro';

interface Props {
  article?: Article;
  action: string;
  method: 'POST' | 'PUT';
  defaultOrder?: number;
}

const { article, action, method, defaultOrder } = Astro.props;
const tagsValue = article?.tags?.join(', ') ?? '';
---

<form
  id="article-form"
  class="admin-form"
  hx-post={method === 'POST' ? action : undefined}
  hx-put={method === 'PUT' ? action : undefined}
  hx-ext="json-enc"
>
  <!-- Section 1: Informasi Utama -->
  <div class="field">
    <label for="title">Judul Artikel <span class="text-rose-400">*</span></label>
    <input
      type="text"
      id="title"
      name="title"
      required
      maxlength="200"
      placeholder="Contoh: Analisis Kerentanan Reentrancy pada Smart Contract"
      value={article?.title ?? ''}
    />
  </div>

  <div class="field">
    <label for="slug">Slug URL <span class="text-rose-400">*</span></label>
    <input
      type="text"
      id="slug"
      name="slug"
      required
      maxlength="100"
      pattern="[a-z0-9-]+"
      placeholder="analisis-kerentanan-reentrancy"
      value={article?.slug ?? ''}
    />
    <p class="field__hint">Huruf kecil, angka, dan tanda hubung. Digunakan pada URL <code>/artikel/[slug]</code>.</p>
  </div>

  <div class="field-row">
    <div class="field">
      <label for="category">Kategori <span class="text-rose-400">*</span></label>
      <select id="category" name="category" required>
        {['SECURITY', 'WEB3', 'WEBDEV', 'GENERAL'].map((c) => (
          <option value={c} selected={article?.category === c}>{c}</option>
        ))}
      </select>
    </div>
    <div class="field">
      <label for="readingTimeMinutes">Estimasi Waktu Baca (menit)</label>
      <input
        type="number"
        id="readingTimeMinutes"
        name="readingTimeMinutes"
        value={article?.readingTimeMinutes ?? 5}
        min="1"
        max="120"
      />
    </div>
  </div>

  <div class="field">
    <label for="summary">Ringkasan Artikel (maks 300 karakter) <span class="text-rose-400">*</span></label>
    <textarea
      id="summary"
      name="summary"
      required
      maxlength="300"
      rows="2"
      placeholder="Deskripsi singkat yang tampil pada kartu artikel dan cuplikan sosial..."
    >{article?.summary ?? ''}</textarea>
  </div>

  <!-- Section 2: Konten Dokumen -->
  <div class="form-section">
    <div class="form-section-title">// KONTEN DOKUMEN</div>
    <div class="field">
      <MarkdownEditor
        id="bodyMarkdown"
        name="bodyMarkdown"
        label="Isi Artikel (Markdown / MDX)"
        initialValue={article?.bodyMarkdown ?? ''}
        required
        uploadFolder="portfolio/articles"
      />
    </div>
  </div>

  <!-- Section 3: Taksonomi & Media -->
  <div class="form-section">
    <div class="form-section-title">// TAKSONOMI & MEDIA</div>
    
    <div class="field">
      <label for="tags">Tag (pisahkan dengan koma)</label>
      <input
        type="text"
        id="tags"
        name="tags"
        data-array-field
        value={tagsValue}
        placeholder="security, web3, audit, smart-contract"
      />
      <p class="field__hint">Contoh: <code>web3, security, vulnerability</code>. Pisahkan tag dengan koma.</p>
    </div>

    <div class="field">
      <label for="cover-file">Cover Image</label>
      <input type="file" id="cover-file" accept="image/jpeg,image/png,image/webp,image/svg+xml" />
      <input type="hidden" id="coverImagePublicId" name="coverImagePublicId" value={article?.coverImagePublicId ?? ''} />
      <p id="cover-upload-status" class="field__hint">
        {article?.coverImagePublicId
          ? `Gambar aktif: ${article.coverImagePublicId} (pilih berkas baru untuk mengganti)`
          : 'Pilih berkas cover (PNG, JPG, WebP, SVG, maks. 5MB) untuk diunggah ke Cloudinary.'}
      </p>
    </div>
  </div>

  <!-- Section 4: Visibilitas & Urutan -->
  <div class="form-section">
    <div class="form-section-title">// VISIBILITAS & URUTAN</div>

    <div class="field-row">
      <div class="field">
        <label for="displayOrder">Urutan Tampil</label>
        <input
          type="number"
          id="displayOrder"
          name="displayOrder"
          value={article?.displayOrder ?? defaultOrder ?? 0}
        />
        <p class="field__hint">Angka lebih tinggi tampil lebih awal di halaman daftar.</p>
      </div>
      <div class="field field--checkbox">
        <input type="checkbox" id="published" name="published" checked={article?.published ?? true} />
        <label for="published">Published (terbitkan langsung ke publik)</label>
      </div>
    </div>
  </div>

  <!-- Section 5: SEO & Metadata -->
  <div class="form-section">
    <div class="form-section-title">// PENGATURAN SEO & METADATA</div>

    <div class="field">
      <label for="metaTitle">Meta Title (SEO, maks 60 karakter)</label>
      <input
        type="text"
        id="metaTitle"
        name="metaTitle"
        maxlength="60"
        value={article?.metaTitle ?? ''}
        placeholder="Judul khusus untuk snippet Google SERP (opsional)"
      />
      <p class="field__hint">Dikosongkan jika ingin otomatis menggunakan judul utama artikel.</p>
    </div>

    <div class="field">
      <label for="metaDescription">Meta Description (SEO, maks 160 karakter)</label>
      <textarea
        id="metaDescription"
        name="metaDescription"
        maxlength="160"
        rows="2"
        placeholder="Deskripsi cuplikan hasil pencarian mesin telusur (opsional)"
      >{article?.metaDescription ?? ''}</textarea>
      <p class="field__hint">Dikosongkan jika ingin otomatis menggunakan ringkasan artikel.</p>
    </div>

    <div class="field">
      <label for="canonicalUrlOverride">Canonical URL Override (opsional)</label>
      <input
        type="url"
        id="canonicalUrlOverride"
        name="canonicalUrlOverride"
        value={article?.canonicalUrlOverride ?? ''}
        placeholder="https://example.com/artikel-asli"
      />
      <p class="field__hint">Isi hanya jika artikel ini sindikasi atau dipublikasikan ulang dari sumber lain.</p>
    </div>

    <div class="field">
      <label for="ogImageOverride">OG Image Override URL (opsional)</label>
      <input
        type="text"
        id="ogImageOverride"
        name="ogImageOverride"
        value={article?.ogImageOverride ?? ''}
        placeholder="https://res.cloudinary.com/.../custom-og.png"
      />
      <p class="field__hint">URL gambar Open Graph khusus jika tidak ingin memakai dynamic OG image generator.</p>
    </div>
  </div>

  <!-- Section 6: Tombol Aksi -->
  <div class="form-actions">
    <button type="submit" form="article-form" class="btn-submit">
      {method === 'POST' ? 'Buat Artikel' : 'Simpan Perubahan'}
    </button>
    <a href="/admin/articles" class="btn-cancel">Batal</a>
    {article && (
      <a
        href={`/admin/preview/articles/${article.id}`}
        target="_blank"
        rel="noopener"
        class="btn-secondary"
      >
        Lihat Pratinjau ↗
      </a>
    )}
  </div>
</form>

<script>
  import { initCloudinaryUploadField } from '../../scripts/admin/cloudinary-upload';

  initCloudinaryUploadField({
    fileInputId: 'cover-file',
    hiddenInputId: 'coverImagePublicId',
    statusId: 'cover-upload-status',
    folder: 'portfolio/articles',
    resourceType: 'image',
    maxSizeBytes: 5_242_880,
  });

  const titleInput = document.getElementById('title') as HTMLInputElement | null;
  const slugInput = document.getElementById('slug') as HTMLInputElement | null;

  titleInput?.addEventListener('input', () => {
    if (!slugInput || slugInput.dataset.manual === 'true') return;
    slugInput.value = titleInput.value
      .toLowerCase()
      .replace(/[^a-z0-9\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .replace(/^-|-$/g, '')
      .slice(0, 100);
  });

  slugInput?.addEventListener('input', () => {
    slugInput.dataset.manual = 'true';
  });

  document.getElementById('article-form')?.addEventListener('htmx:configRequest', ((event: CustomEvent) => {
    const params = event.detail.parameters;
    if (typeof params.tags === 'string') {
      params.tags = JSON.stringify(
        params.tags
          .split(',')
          .map((s: string) => s.trim())
          .filter(Boolean),
      );
    }
    params.published = params.published === 'on';
    params.displayOrder = Number(params.displayOrder) || 0;
    params.readingTimeMinutes = Number(params.readingTimeMinutes) || 5;
  }) as EventListener);
</script>
