---
import '../../styles/admin-forms.css';
import type { Article } from '../../db/schema';

interface Props {
  article?: Article;
  action: string;
  method: 'POST' | 'PUT';
}

const { article, action, method } = Astro.props;
const tagsValue = article?.tags?.join(', ') ?? '';
---

<form
  id="article-form"
  class="admin-form"
  hx-post={method === 'POST' ? action : undefined}
  hx-put={method === 'PUT' ? action : undefined}
  hx-ext="json-enc"
>
  <div class="field">
    <label for="title">Judul</label>
    <input type="text" id="title" name="title" required maxlength="200" value={article?.title ?? ''} />
  </div>

  <div class="field">
    <label for="slug">Slug</label>
    <input
      type="text"
      id="slug"
      name="slug"
      required
      maxlength="100"
      pattern="[a-z0-9-]+"
      value={article?.slug ?? ''}
    />
    <p class="field__hint">Huruf kecil, angka, tanda hubung. Dipakai di URL /articles/[slug].</p>
  </div>

  <div class="field-row">
    <div class="field">
      <label for="category">Kategori</label>
      <select id="category" name="category" required>
        {['SECURITY', 'WEB3', 'WEBDEV', 'GENERAL'].map((c) => (
          <option value={c} selected={article?.category === c}>{c}</option>
        ))}
      </select>
    </div>
    <div class="field">
      <label for="readingTimeMinutes">Waktu baca (menit)</label>
      <input type="number" id="readingTimeMinutes" name="readingTimeMinutes" value={article?.readingTimeMinutes ?? 5} min="1" />
    </div>
  </div>

  <div class="field">
    <label for="summary">Ringkasan (maks 300 karakter)</label>
    <textarea id="summary" name="summary" required maxlength="300" rows="2">{article?.summary ?? ''}</textarea>
  </div>

  <div class="field">
    <label for="bodyMarkdown">Isi (Markdown)</label>
    <textarea id="bodyMarkdown" name="bodyMarkdown" required rows="10">{article?.bodyMarkdown ?? ''}</textarea>
  </div>

  <div class="field">
    <label for="tags">Tag (pisahkan dengan koma)</label>
    <input type="text" id="tags" name="tags" data-array-field value={tagsValue} />
  </div>

  <div class="field">
    <label for="cover-file">Cover image</label>
    <input type="file" id="cover-file" accept="image/*" />
    <input type="hidden" id="coverImagePublicId" name="coverImagePublicId" value={article?.coverImagePublicId ?? ''} />
    <p id="cover-upload-status" class="field__hint"></p>
  </div>

  <div class="field-row">
    <div class="field">
      <label for="displayOrder">Urutan tampil</label>
      <input type="number" id="displayOrder" name="displayOrder" value={article?.displayOrder ?? 0} />
    </div>
    <div class="field field--checkbox">
      <input type="checkbox" id="published" name="published" checked={article?.published ?? true} />
      <label for="published">Published</label>
    </div>
  </div>

  <div class="field">
    <label for="metaTitle">Meta Title (SEO, maks 60 karakter)</label>
    <input type="text" id="metaTitle" name="metaTitle" maxlength="60" value={article?.metaTitle ?? ''} />
  </div>

  <div class="field">
    <label for="metaDescription">Meta Description (SEO, maks 160 karakter)</label>
    <textarea id="metaDescription" name="metaDescription" maxlength="160" rows="2">{article?.metaDescription ?? ''}</textarea>
  </div>

  <div class="field">
    <label for="canonicalUrlOverride">Canonical URL Override (opsional)</label>
    <input
      type="url"
      id="canonicalUrlOverride"
      name="canonicalUrlOverride"
      value={article?.canonicalUrlOverride ?? ''}
      placeholder="https://example.com/artikel-asli"
    />
    <p class="field__hint">Isi hanya jika artikel ini sindikasi atau dipublikasikan ulang dari sumber lain.</p>
  </div>

  <div class="field">
    <label for="ogImageOverride">OG Image Override URL (opsional)</label>
    <input
      type="text"
      id="ogImageOverride"
      name="ogImageOverride"
      value={article?.ogImageOverride ?? ''}
      placeholder="https://example.com/custom-og.png"
    />
  </div>

  <button type="submit">{method === 'POST' ? 'Buat Artikel' : 'Simpan Perubahan'}</button>
</form>

<script>
  import { initCloudinaryUploadField } from '../../scripts/admin/cloudinary-upload';

  initCloudinaryUploadField({
    fileInputId: 'cover-file',
    hiddenInputId: 'coverImagePublicId',
    statusId: 'cover-upload-status',
    folder: 'portfolio/articles',
    resourceType: 'image',
    maxSizeBytes: 5_242_880,
  });

  const titleInput = document.getElementById('title') as HTMLInputElement | null;
  const slugInput = document.getElementById('slug') as HTMLInputElement | null;

  titleInput?.addEventListener('input', () => {
    if (!slugInput || slugInput.dataset.manual === 'true') return;
    slugInput.value = titleInput.value
      .toLowerCase()
      .replace(/[^a-z0-9\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .replace(/^-|-$/g, '')
      .slice(0, 100);
  });

  slugInput?.addEventListener('input', () => {
    slugInput.dataset.manual = 'true';
  });

  document.getElementById('article-form')?.addEventListener('htmx:configRequest', ((event: CustomEvent) => {
    const params = event.detail.parameters;
    if (typeof params.tags === 'string') {
      params.tags = JSON.stringify(
        params.tags
          .split(',')
          .map((s: string) => s.trim())
          .filter(Boolean),
      );
    }
    params.published = params.published === 'on';
    params.displayOrder = Number(params.displayOrder) || 0;
    params.readingTimeMinutes = Number(params.readingTimeMinutes) || 5;
  }) as EventListener);
</script>
