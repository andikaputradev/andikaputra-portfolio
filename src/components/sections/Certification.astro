---
import { db } from '../../db';
import { certifications, type Certification as CertificationItem } from '../../db/schema';
import { eq, desc } from 'drizzle-orm';
import CertificationCard from '../work/CertificationCard.astro';

interface Props {
  items?: CertificationItem[];
}

const items =
  Astro.props.items ??
  (await db
    .select()
    .from(certifications)
    .where(eq(certifications.published, true))
    .orderBy(desc(certifications.displayOrder)));

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
---

{items.length > 0 && (
  <section id="certifications" class="cert-section section-spacing" data-telemetry-section="certifications">
    <div class="container-site">
      <div class="cert-section__header">
        <p class="cert-section__eyebrow font-mono">02 // VERIFIED CREDENTIALS</p>
        <h2 class="cert-section__heading font-display">Certifications</h2>
        <p class="cert-section__subhead" style="margin-top: 1rem; color: var(--color-text-muted);">
          Verified credentials in software engineering and security. <a href="https://linkedin.com/in/wahyu-andika-putra" target="_blank" style="color:var(--color-accent-phosphor); text-decoration:none;">View on LinkedIn</a>
        </p>
      </div>
      <div class="cert-grid">
        {items.map((cert) => (
          <div class="cert-grid__item">
            <CertificationCard
              name={cert.name}
              issuer={cert.issuer}
              issueDateLabel={formatDate(cert.issueDate)}
              assetPublicId={cert.assetPublicId}
              assetFormat={cert.assetFormat}
              verificationUrl={cert.verificationUrl}
            />
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<script>
  import { initSpotlightCards } from '../../scripts/spotlight-card';

  document.addEventListener('astro:page-load', () => {
    initSpotlightCards('#certifications [data-spotlight]');
  });
</script>

<style>
  .cert-section {
    padding-block: var(--spacing-section);
  }

  .cert-section__header {
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
  }

  .cert-section__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--color-accent-phosphor);
    margin-bottom: 0.5rem;
  }

  .cert-section__heading {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1.5rem;
  }

  .cert-grid__item {
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }
</style>
