---
import { db } from '../../db';
import { articles, type Article } from '../../db/schema';
import { eq, desc } from 'drizzle-orm';

interface Props {
  articles?: Article[];
}

const latestArticles =
  Astro.props.articles ??
  (await db
    .select()
    .from(articles)
    .where(eq(articles.published, true))
    .orderBy(desc(articles.displayOrder))
    .limit(3));

const CATEGORY_LABELS: Record<string, string> = {
  SECURITY: 'Security',
  WEB3: 'Web3',
  WEBDEV: 'Web Dev',
  GENERAL: 'General',
};
---

<section id="articles" class="home-articles" data-telemetry-section="articles">
  <div class="container-site">
    <h2 class="home-articles__heading font-display">Artikel Terbaru</h2>

    <div class="home-articles__grid">
      {latestArticles.map((article) => (
        <article class="article-card" data-spotlight>
          <span class="cyber-corner cyber-corner--tl" aria-hidden="true"></span>
          <span class="cyber-corner cyber-corner--br" aria-hidden="true"></span>
          <a href={`/artikel/${article.slug}/`} class="article-card__link">
            <div class="article-card__header">
              <span class={`article-card__category font-mono article-card__category--${article.category.toLowerCase()}`}>
                [{CATEGORY_LABELS[article.category] ?? article.category}]
              </span>
              {article.readingTimeMinutes && (
                <span class="article-card__reading-time font-mono">{article.readingTimeMinutes} min read</span>
              )}
            </div>
            <h3 class="article-card__title" data-scramble>{article.title}</h3>
            <p class="article-card__summary">{article.summary}</p>
            <div class="article-card__meta font-mono">
              <time datetime={article.publishedAt.toISOString()}>
                {new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(article.publishedAt)}
              </time>
            </div>
          </a>
        </article>
      ))}
    </div>

    {latestArticles.length > 0 && (
      <div class="home-articles__cta">
        <a href="/artikel/" class="home-articles__link font-mono">[ Lihat semua artikel ]</a>
      </div>
    )}
  </div>
</section>

<script>
  import { initSpotlightCards } from '../../scripts/spotlight-card';
  import { initTextScramble } from '../../scripts/text-scramble';

  document.addEventListener('astro:page-load', () => {
    initSpotlightCards('[data-spotlight]');
    initTextScramble('[data-scramble]');
  });
</script>

<style>
  .home-articles {
    padding-block: var(--spacing-section);
  }

  .home-articles__heading {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .home-articles__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .home-articles__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .home-articles__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .home-articles__cta {
    margin-top: clamp(2rem, 4vw, 3rem);
    text-align: center;
  }

  .home-articles__link {
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    color: var(--color-accent-phosphor);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .home-articles__link:hover {
    color: var(--color-text-primary);
  }

  .article-card {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .article-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      380px circle at var(--mouse-x, -999px) var(--mouse-y, -999px),
      oklch(72% 0.14 55 / 10%),
      transparent 75%
    );
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 0;
  }

  .article-card::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: radial-gradient(
      240px circle at var(--mouse-x, -999px) var(--mouse-y, -999px),
      oklch(72% 0.14 55 / 45%),
      transparent 70%
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 2;
  }

  .article-card:hover {
    border-color: color-mix(in oklch, var(--color-accent-phosphor) 30%, var(--color-border));
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .article-card:hover::before,
  .article-card:hover::after {
    opacity: 1;
  }

  .cyber-corner {
    position: absolute;
    width: 6px;
    height: 6px;
    border-color: var(--color-accent-phosphor);
    border-style: solid;
    pointer-events: none;
    z-index: 3;
    opacity: 0.5;
  }

  .cyber-corner--tl {
    top: 6px;
    left: 6px;
    border-width: 1.5px 0 0 1.5px;
  }

  .cyber-corner--br {
    bottom: 6px;
    right: 6px;
    border-width: 0 1.5px 1.5px 0;
  }

  .article-card:hover .cyber-corner {
    opacity: 1;
  }

  .article-card__link {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    flex: 1;
    text-decoration: none;
    color: inherit;
    padding: 1.75rem;
  }

  .article-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .article-card__category {
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    width: fit-content;
  }

  .article-card__category--security {
    color: var(--color-accent-phosphor);
    border-color: color-mix(in oklch, var(--color-accent-phosphor) 40%, transparent);
  }

  .article-card__category--web3 {
    color: var(--color-accent-steel);
    border-color: color-mix(in oklch, var(--color-accent-steel) 40%, transparent);
  }

  .article-card__category--webdev {
    color: #a78bfa;
    border-color: color-mix(in oklch, #a78bfa 40%, transparent);
  }

  .article-card__category--general {
    color: var(--color-text-muted);
  }

  .article-card__reading-time {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  .article-card__title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.3;
    margin-bottom: 0.75rem;
    transition: color var(--transition-fast);
  }

  .article-card__link:hover .article-card__title {
    color: var(--color-accent-phosphor);
  }

  .article-card__summary {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    flex: 1;
    margin-bottom: 1.25rem;
  }

  .article-card__meta {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border);
  }
</style>
