---
import { db } from '../../db';
import { projects, type Project } from '../../db/schema';
import { eq, desc } from 'drizzle-orm';
import ProjectCard from '../work/ProjectCard.astro';
import ProjectFilter from '../work/ProjectFilter.astro';

interface Props {
  projects?: Project[];
}

const sortedProjects =
  Astro.props.projects ??
  (await db
    .select()
    .from(projects)
    .where(eq(projects.published, true))
    .orderBy(desc(projects.displayOrder)));

const featuredProjects = sortedProjects.slice(0, 3);
---

<section id="work" class="selected-work" data-telemetry-section="work">
  <div class="container-site">
    <div class="selected-work__header">
      <div class="selected-work__eyebrow font-mono">
        <span class="selected-work__telemetry-tag">03 // WORK ARCHIVE</span>
        <span class="selected-work__count">SYSTEMS ACTIVE: {sortedProjects.length}</span>
      </div>
      <h2 class="selected-work__heading font-display">Selected Work</h2>
      <p class="selected-work__subhead">
        Explore my latest projects and security audits. <a href="/work" style="color:var(--color-accent-phosphor); text-decoration:none;">View all work</a>
      </p>
    </div>

    <!-- Featured Coverflow Showcase -->
    <div class="selected-work__featured selected-work__featured--motion">
      <swiper-container
        effect="coverflow"
        grab-cursor="true"
        centered-slides="true"
        slides-per-view="auto"
        coverflow-effect-rotate="0"
        coverflow-effect-stretch="0"
        coverflow-effect-depth="120"
        coverflow-effect-modifier="1"
        navigation="true"
        keyboard="true"
      >
        {
          featuredProjects.map((project, idx) => (
            <swiper-slide>
              <ProjectCard project={project} index={idx + 1} enableTransition={!project.flagship} />
            </swiper-slide>
          ))
        }
      </swiper-container>
    </div>

    <div class="selected-work__featured selected-work__featured--reduced">
      <swiper-container
        effect="fade"
        fade-effect-cross-fade="true"
        slides-per-view="1"
        navigation="true"
        keyboard="true"
      >
        {
          featuredProjects.map((project, idx) => (
            <swiper-slide>
              <ProjectCard project={project} index={idx + 1} enableTransition={false} />
            </swiper-slide>
          ))
        }
      </swiper-container>
    </div>

    <!-- Interactive Category Filter Switcher -->
    <ProjectFilter />

    <!-- Project Cards Grid with Spotlight -->
    <div class="selected-work__grid" data-project-grid>
      {
        sortedProjects.map((project, idx) => (
          <ProjectCard project={project} index={idx + 1} enableTransition={!project.flagship} />
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initSpotlightCards } from '../../scripts/spotlight-card';
  import { initTextScramble } from '../../scripts/text-scramble';

  document.addEventListener('astro:page-load', () => {
    initSpotlightCards('[data-spotlight]');
    initTextScramble('[data-scramble]');

    const swiperEl = document.querySelector('swiper-container');
    if (!swiperEl) return;

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries[0]?.isIntersecting) {
            observer.disconnect();
            import('../../scripts/swiper-init').then(({ ensureSwiperRegistered }) => {
              ensureSwiperRegistered();
            });
          }
        },
        { rootMargin: '300px' },
      );
      observer.observe(swiperEl);
    } else {
      import('../../scripts/swiper-init').then(({ ensureSwiperRegistered }) => {
        ensureSwiperRegistered();
      });
    }
  });
</script>

<style>
  .selected-work {
    padding-block: var(--spacing-section);
    position: relative;
  }

  .selected-work__header {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    max-width: 65ch;
  }

  .selected-work__eyebrow {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--color-accent-phosphor);
    margin-bottom: 0.75rem;
  }

  .selected-work__count {
    color: var(--color-text-muted);
    font-size: 0.6875rem;
    opacity: 0.8;
  }

  .selected-work__heading {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.1;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .selected-work__subhead {
    font-size: clamp(0.9375rem, 1.8vw, 1.125rem);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .selected-work__featured {
    margin-bottom: 3.5rem;
  }

  .selected-work__featured--reduced {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .selected-work__featured--motion {
      display: none;
    }

    .selected-work__featured--reduced {
      display: block;
    }

    .selected-work__featured--reduced swiper-slide {
      width: 100%;
      max-width: 100%;
      flex: 1 0 100%;
    }
  }

  swiper-container {
    display: flex;
    overflow-x: auto;
    gap: 1.5rem;
    padding-block: 1.5rem 2.5rem;
  }

  swiper-slide {
    display: block;
    flex: 0 0 auto;
    width: 320px;
    max-width: 320px;
  }

  .selected-work__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  .selected-work__grid :global(.is-filtered-out) {
    display: none;
  }

  @media (min-width: 768px) {
    .selected-work__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .selected-work__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 479px) {
    swiper-slide {
      width: 84vw;
      max-width: 84vw;
    }
  }
</style>
