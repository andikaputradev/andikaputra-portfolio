---
import { RD_LAB } from '../../data/rd-lab';
---

<section id="rd-lab" class="rd-lab" data-telemetry-section="rd-lab">
  <div class="container-site">
    <div class="rd-lab__header">
      <p class="rd-lab__eyebrow font-mono">04 // EXPERIMENTAL RESEARCH</p>
      <h2 class="rd-lab__heading font-display">R&D Lab</h2>
      <p class="rd-lab__subhead">
        Prototypes, security proof-of-concepts, and cryptographic experimentations. <a href="https://github.com/andikaputradev" target="_blank" style="color:var(--color-accent-phosphor); text-decoration:none;">View on GitHub</a>
      </p>
    </div>

    <ul class="rd-lab-list">
      {
        RD_LAB.map((entry) => (
          <li class="rd-lab-item">
            <span class="rd-lab-item__tag font-mono">[{entry.tag}]</span>
            <span class="rd-lab-item__name font-mono" data-scramble>{entry.name}</span>
            <span class="rd-lab-item__desc">{entry.desc}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { initRdLabEntrance } from '../../scripts/anime-svg';
  import { initTextScramble } from '../../scripts/text-scramble';

  document.addEventListener('astro:page-load', () => {
    initRdLabEntrance();
    initTextScramble('#rd-lab [data-scramble]');
  });
</script>

<style>
  .rd-lab {
    padding-block: var(--spacing-section);
  }

  .rd-lab__header {
    margin-bottom: clamp(2rem, 5vw, 3rem);
    max-width: 60ch;
  }

  .rd-lab__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--color-accent-phosphor);
    margin-bottom: 0.75rem;
  }

  .rd-lab__heading {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .rd-lab__subhead {
    font-size: 1rem;
    color: var(--color-text-muted);
  }

  .rd-lab-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .rd-lab-item {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    padding: 1.25rem 1rem;
    border-bottom: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    transition:
      background-color var(--transition-fast),
      transform var(--transition-fast),
      border-color var(--transition-fast);
  }

  .rd-lab-item:hover {
    background-color: color-mix(in oklch, var(--color-surface-raised) 70%, transparent);
    transform: translateX(4px);
  }

  .rd-lab-item__tag {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--color-accent-steel);
  }

  .rd-lab-item__name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-primary);
    transition: color var(--transition-fast);
  }

  .rd-lab-item:hover .rd-lab-item__name {
    color: var(--color-accent-phosphor);
  }

  .rd-lab-item__desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .rd-lab-item {
      grid-template-columns: 8rem 14rem 1fr;
      align-items: baseline;
      gap: 1.5rem;
    }
  }
</style>
