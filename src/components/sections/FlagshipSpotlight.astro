---
import { db } from '../../db';
import { projects, type Project } from '../../db/schema';
import { and, eq, desc } from 'drizzle-orm';
import DisclaimerNotice from '../ui/DisclaimerNotice.astro';
import TagBadge from '../ui/TagBadge.astro';
import MagneticButton from '../ui/MagneticButton.astro';
import { resolveCoverImage, resolveCoverImageSrcSet } from '../../lib/cloudinary-url';
import { renderProjectBody } from '../../lib/render-markdown';

interface Props {
  flagship?: Project | null;
}

let flagship = Astro.props.flagship;

if (flagship === undefined) {
  const [found] = await db
    .select()
    .from(projects)
    .where(and(eq(projects.flagship, true), eq(projects.published, true)))
    .orderBy(desc(projects.displayOrder))
    .limit(1);

  if (found) {
    flagship = found;
  } else {
    const [fallback] = await db
      .select()
      .from(projects)
      .where(eq(projects.published, true))
      .orderBy(desc(projects.displayOrder))
      .limit(1);
    flagship = fallback ?? null;
  }
}

const coverSrc = flagship ? resolveCoverImage(flagship, 'f_auto,q_auto,w_900,h_675,c_fill') : null;
const coverSrcSet = flagship ? resolveCoverImageSrcSet(flagship, [450, 700, 900, 1200], 'f_auto,q_auto,c_fill') : undefined;
const bodyHtml = flagship ? renderProjectBody(flagship.bodyMarkdown, { demoteH1: true }) : '';
---

{flagship && (
<section class="flagship" data-flagship data-telemetry-section="security">
  <canvas id="flagship-canvas" class="flagship__canvas" aria-hidden="true"></canvas>

  <div class="flagship__inner container-site">
    <!-- Media Frame with Cyber Accents -->
    <div class="flagship__media-container">
      <div class="flagship__media cover-image-wrap">
        <span class="cyber-corner cyber-corner--tl" aria-hidden="true"></span>
        <span class="cyber-corner cyber-corner--br" aria-hidden="true"></span>

        {coverSrc ? (
          <img
            src={coverSrc}
            srcset={coverSrcSet}
            sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 800px"
            width="900"
            height="675"
            alt={`${flagship.title} product interface`}
            class="flagship__image js-cover-image"
            loading="lazy"
            decoding="async"
            transition:name={`project-image-${flagship.slug}`}
          />
        ) : (
          <img alt="" width="900" height="675" class="flagship__image js-cover-image is-broken" loading="lazy" />
        )}

        <div class="flagship__media-hud font-mono" aria-hidden="true">
          <span>SYS::SPOTLIGHT</span>
          <span>ONLINE // 100%</span>
        </div>
      </div>
    </div>

    <!-- Editorial Story Text -->
    <div class="flagship__text" data-flagship-text>
      <div class="flagship__header-meta font-mono">
        <span class="flagship__eyebrow-tag">02 // FLAGSHIP SYSTEM</span>
        <TagBadge tag={flagship.tag} />
      </div>

      <h2 class="flagship__title font-display" data-scramble>{flagship.title}</h2>

      <div class="flagship__copy" set:html={bodyHtml} />

      <DisclaimerNotice />

      <div class="flagship__cta">
        <MagneticButton href={`/work/${flagship.slug}/`} variant="primary">
          View case study
        </MagneticButton>
      </div>
    </div>
  </div>
</section>
)}

<script>
  import { initFlagshipReveal } from '../../scripts/flagship-reveal';
  import { initTextScramble } from '../../scripts/text-scramble';

  document.addEventListener('astro:page-load', () => {
    initFlagshipReveal();
    initTextScramble('[data-flagship] [data-scramble]');

    const isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    if (!isReduced && !isMobile) {
      const loadParticles = () => {
        import('../../scripts/three-hero').then(({ mountParticleCanvas }) => {
          mountParticleCanvas('#flagship-canvas', {
            opacity: 0.2,
            rotationSpeed: 0.00005,
            particleCountDesktop: 1000,
          });
        });
      };
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(loadParticles, { timeout: 3500 });
      } else {
        setTimeout(loadParticles, 1500);
      }
    }
  });
</script>

<style>
  .flagship {
    position: relative;
    overflow: hidden;
    padding-block: var(--spacing-section);
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .flagship__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .flagship__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  .flagship__media-container {
    position: relative;
  }

  .flagship__media {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface-raised);
    box-shadow: var(--shadow-md);
    transition: box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .flagship:hover .flagship__media {
    box-shadow: var(--shadow-xl);
    border-color: color-mix(in oklch, var(--color-accent-phosphor) 35%, var(--color-border));
  }

  .cyber-corner {
    position: absolute;
    width: 8px;
    height: 8px;
    border-color: var(--color-accent-phosphor);
    border-style: solid;
    pointer-events: none;
    z-index: 4;
    opacity: 0.7;
  }

  .cyber-corner--tl {
    top: 8px;
    left: 8px;
    border-width: 2px 0 0 2px;
  }

  .cyber-corner--br {
    bottom: 8px;
    right: 8px;
    border-width: 0 2px 2px 0;
  }

  .flagship__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .flagship:hover .flagship__image {
    transform: scale(1.02);
  }

  .flagship__media-hud {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 1rem;
    background: linear-gradient(to top, color-mix(in oklch, var(--color-bg) 85%, transparent), transparent);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--color-accent-phosphor);
    pointer-events: none;
  }

  .flagship__header-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .flagship__eyebrow-tag {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--color-accent-phosphor);
  }

  .flagship__title {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    line-height: 1.08;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .flagship__copy {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    max-width: 58ch;
    margin-bottom: 1.75rem;
  }

  .flagship__cta {
    margin-top: 1.75rem;
  }

  @media (min-width: 1024px) {
    .flagship__inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 4.5rem;
    }
  }

  [data-theme="light"] .flagship {
    background-color: var(--color-surface);
  }
</style>
