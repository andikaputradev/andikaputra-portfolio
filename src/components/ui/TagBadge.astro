---
import type { ProjectTag } from '../../lib/types';

interface Props {
  tag: ProjectTag;
}

const { tag } = Astro.props;
---

<span class={`tag-badge tag-badge--${tag.toLowerCase()}`}>
  <span class="tag-badge__prefix" aria-hidden="true">::</span>
  <span class="tag-badge__text">{tag}</span>
</span>

<style>
  .tag-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-mono), monospace;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background-color: color-mix(in oklch, var(--color-surface-raised) 50%, transparent);
    width: fit-content;
    line-height: 1.4;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .tag-badge__prefix {
    opacity: 0.6;
    font-size: 0.625rem;
  }

  .tag-badge--security {
    color: var(--color-accent-phosphor);
    border-color: color-mix(in oklch, var(--color-accent-phosphor) 35%, transparent);
  }

  .tag-badge--web2 {
    color: var(--color-text-primary);
    border-color: color-mix(in oklch, var(--color-text-primary) 25%, transparent);
  }

  .tag-badge--web3 {
    color: var(--color-accent-steel);
    border-color: color-mix(in oklch, var(--color-accent-steel) 35%, transparent);
  }

  [data-theme="light"] .tag-badge {
    background-color: var(--color-surface);
  }
</style>
