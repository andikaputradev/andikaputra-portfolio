---
export interface Props {
  src: string;
  alt: string;
  width?: string | number;
  height?: string | number;
}

const { src, alt, width, height } = Astro.props;
---

<figure class="my-8">
  <picture>
    <img 
      src={src} 
      alt={alt || "Article image"} 
      width={width}
      height={height}
      loading="lazy"
      decoding="async"
      class="w-full h-auto rounded-xl border border-slate-800 shadow-md bg-slate-900 object-cover"
    />
  </picture>
  {alt && <figcaption class="text-center text-sm text-slate-400 mt-2 font-mono">{alt}</figcaption>}
</figure>
