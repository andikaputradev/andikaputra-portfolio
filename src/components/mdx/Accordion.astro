---
export interface Props {
  title: string;
}
const { title } = Astro.props;
---
<details class="group my-6 border border-slate-700 rounded-lg bg-slate-900/50 open:bg-slate-800/50 transition-colors">
  <summary class="flex items-center justify-between px-4 py-3 font-semibold cursor-pointer text-slate-200 focus:outline-none focus:ring-2 focus:ring-cyan-500 rounded-lg">
    {title}
    <span class="transition-transform group-open:rotate-180">▼</span>
  </summary>
  <div class="px-4 pb-4 pt-2 text-slate-300 border-t border-slate-700 prose prose-invert max-w-none">
    <slot />
  </div>
</details>
