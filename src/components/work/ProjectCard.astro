---
import type { Project } from '../../db/schema';
import TagBadge from '../ui/TagBadge.astro';
import ProjectCover from '../ui/ProjectCover.astro';

interface Props {
  project: Project;
  index?: number;
  enableTransition?: boolean;
}

const { project, index, enableTransition = true } = Astro.props;
const stack = project.stack ?? [];
const displayIndex = String(index ?? project.displayOrder ?? 1).padStart(2, '0');
---

<article
  class="project-card"
  data-project-card
  data-project-tag={project.tag}
  data-spotlight
>
  <span class="cyber-corner cyber-corner--tl" aria-hidden="true"></span>
  <span class="cyber-corner cyber-corner--br" aria-hidden="true"></span>

  <a href={`/work/${project.slug}/`} class="project-card__link">
    <!-- Top Telemetry Row -->
    <div class="project-card__telemetry">
      <div class="project-card__meta-group">
        <TagBadge tag={project.tag} />
        <span class="project-card__index font-mono">#{displayIndex}</span>
      </div>
      {project.flagship && (
        <span class="project-card__flagship font-mono">
          <span class="project-card__flagship-dot" aria-hidden="true"></span>
          FLAGSHIP
        </span>
      )}
    </div>

    <!-- Media Container with Aspect Ratio Frame -->
    <div class="project-card__image-wrap cover-image-wrap">
      <ProjectCover
        project={project}
        class="project-card__image js-cover-image"
        widths={[400, 768, 1020]}
        sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 800px"
        loading="lazy"
        decoding="async"
        transitionName={enableTransition ? `project-image-${project.slug}` : undefined}
      />
      <div class="project-card__image-overlay" aria-hidden="true"></div>
    </div>

    <!-- Body Information -->
    <div class="project-card__body">
      <h3 class="project-card__title" data-scramble>{project.title}</h3>
      <p class="project-card__summary">{project.summary}</p>

      {stack.length > 0 && (
        <div class="project-card__stack font-mono">
          {stack.slice(0, 3).map((tech: string) => (
            <span class="project-card__tech-tag">{tech}</span>
          ))}
          {stack.length > 3 && (
            <span class="project-card__tech-more">+{stack.length - 3}</span>
          )}
        </div>
      )}
    </div>
  </a>

  <!-- Footer Actions with Distinct Visual Hues (GitHub vs Live) -->
  {(project.repoUrl || project.liveUrl) && (
    <div class="project-card__actions">
      {project.repoUrl && (
        <a
          href={project.repoUrl}
          target="_blank"
          rel="noopener"
          class="project-card__action project-card__action--github font-mono"
          title={`Lihat repositori ${project.title} di GitHub`}
          aria-label={`Repositori GitHub untuk ${project.title}`}
        >
          <svg class="project-card__action-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
          <span>GitHub</span>
        </a>
      )}
      {project.liveUrl && (
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener"
          class="project-card__action project-card__action--live font-mono"
          title={`Buka live demo ${project.title}`}
          aria-label={`Demo live untuk ${project.title}`}
        >
          <span class="project-card__live-beacon" aria-hidden="true"></span>
          <span>Live</span>
          <svg class="project-card__action-icon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      )}
    </div>
  )}
</article>

<style>
  .project-card {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    box-shadow: var(--shadow-sm);
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base),
      transform var(--transition-base);
    overflow: hidden;
  }

  /* Spotlight radial background highlight */
  .project-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      450px circle at var(--mouse-x, -999px) var(--mouse-y, -999px),
      oklch(72% 0.14 55 / 10%),
      transparent 75%
    );
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
    z-index: 0;
  }

  /* Spotlight border sheen */
  .project-card::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: radial-gradient(
      280px circle at var(--mouse-x, -999px) var(--mouse-y, -999px),
      oklch(72% 0.14 55 / 55%),
      transparent 70%
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
    z-index: 2;
  }

  .project-card:hover,
  .project-card.is-touched,
  .project-card.is-in-view {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    border-color: color-mix(in oklch, var(--color-accent-phosphor) 35%, var(--color-border));
  }

  .project-card:hover::before,
  .project-card:hover::after,
  .project-card.is-touched::before,
  .project-card.is-touched::after,
  .project-card.is-in-view::before,
  .project-card.is-in-view::after {
    opacity: 1;
  }

  /* Cyber corner accents */
  .cyber-corner {
    position: absolute;
    width: 6px;
    height: 6px;
    border-color: color-mix(in oklch, var(--color-accent-phosphor) 60%, transparent);
    border-style: solid;
    pointer-events: none;
    opacity: 0.6;
    transition: opacity var(--transition-fast), border-color var(--transition-fast);
    z-index: 3;
  }

  .cyber-corner--tl {
    top: 6px;
    left: 6px;
    border-width: 1.5px 0 0 1.5px;
  }

  .cyber-corner--br {
    bottom: 6px;
    right: 6px;
    border-width: 0 1.5px 1.5px 0;
  }

  .project-card:hover .cyber-corner,
  .project-card.is-touched .cyber-corner,
  .project-card.is-in-view .cyber-corner {
    opacity: 1;
    border-color: var(--color-accent-phosphor);
  }

  .project-card__link {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    flex: 1;
    text-decoration: none;
    color: inherit;
  }

  /* Telemetry Header */
  .project-card__telemetry {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
    gap: 0.5rem;
  }

  .project-card__meta-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .project-card__index {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    opacity: 0.8;
  }

  .project-card__flagship {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-accent-phosphor);
    background-color: color-mix(in oklch, var(--color-accent-phosphor) 12%, transparent);
    border: 1px solid color-mix(in oklch, var(--color-accent-phosphor) 30%, transparent);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
  }

  .project-card__flagship-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--color-accent-phosphor);
    display: inline-block;
  }

  /* Image Frame */
  .project-card__image-wrap {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    margin-bottom: 1rem;
    background-color: var(--color-surface-raised);
    aspect-ratio: 16 / 10;
  }

  .project-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
    filter: saturate(0.95);
  }

  .project-card__link:hover .project-card__image {
    transform: scale(1.04);
    filter: saturate(1.05);
  }

  .project-card__image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, color-mix(in oklch, var(--color-surface) 40%, transparent) 0%, transparent 60%);
    pointer-events: none;
  }

  /* Body Content */
  .project-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .project-card__title {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text-primary);
    transition: color var(--transition-fast);
    font-family: var(--font-sans);
    letter-spacing: -0.01em;
  }

  .project-card__link:hover .project-card__title {
    color: var(--color-accent-phosphor);
  }

  .project-card__summary {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Stack tags */
  .project-card__stack {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.6rem;
  }

  .project-card__tech-tag {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    background-color: color-mix(in oklch, var(--color-surface-raised) 70%, transparent);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    letter-spacing: 0.02em;
  }

  .project-card__tech-more {
    font-size: 0.6875rem;
    color: var(--color-accent-phosphor);
    opacity: 0.85;
  }

  /* Actions with distinct colors for GitHub vs Live */
  .project-card__actions {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px solid color-mix(in oklch, var(--color-border) 70%, transparent);
  }

  .project-card__action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .project-card__action-icon {
    transition: transform var(--transition-fast);
    flex-shrink: 0;
  }

  /* GitHub Action: Telemetry Steel / Slate */
  .project-card__action--github {
    color: var(--color-accent-steel);
    background-color: color-mix(in oklch, var(--color-surface-raised) 60%, transparent);
    border: 1px solid color-mix(in oklch, var(--color-accent-steel) 30%, var(--color-border));
  }

  .project-card__action--github:hover {
    color: var(--color-text-primary);
    border-color: var(--color-accent-steel);
    background-color: color-mix(in oklch, var(--color-accent-steel) 12%, transparent);
    box-shadow: 0 0 10px oklch(75% 0.08 220 / 22%);
  }

  .project-card__action--github:hover .project-card__action-icon {
    transform: translateY(-1px);
  }

  /* Live Action: Radiant Phosphor Amber / Cyber Beacon */
  .project-card__action--live {
    color: var(--color-accent-phosphor);
    background-color: color-mix(in oklch, var(--color-accent-phosphor) 10%, transparent);
    border: 1px solid color-mix(in oklch, var(--color-accent-phosphor) 45%, transparent);
    font-weight: 500;
  }

  .project-card__live-beacon {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent-phosphor);
    box-shadow: 0 0 6px var(--color-accent-phosphor);
    flex-shrink: 0;
  }

  .project-card__action--live:hover {
    color: var(--color-text-primary);
    background-color: color-mix(in oklch, var(--color-accent-phosphor) 24%, transparent);
    border-color: var(--color-accent-phosphor);
    box-shadow: 0 0 14px oklch(72% 0.14 55 / 30%);
  }

  .project-card__action--live:hover .project-card__action-icon {
    transform: translate(1px, -1px);
  }

  /* Light mode adjustments */
  [data-theme="light"] .project-card {
    background-color: var(--color-surface);
    border-color: var(--color-border);
  }

  [data-theme="light"] .project-card__action--github {
    background-color: var(--color-surface-raised);
    color: var(--color-accent-steel);
    border-color: var(--color-border);
  }

  [data-theme="light"] .project-card__action--live {
    background-color: color-mix(in oklch, var(--color-accent-phosphor) 12%, transparent);
    border-color: var(--color-accent-phosphor);
    color: var(--color-accent-phosphor);
  }
</style>
