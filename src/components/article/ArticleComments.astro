---
interface CommentItem {
  id: number;
  authorName: string;
  rating: number;
  content: string;
  createdAt: Date;
}

interface Props {
  articleId: number;
  articleSlug: string;
  comments: CommentItem[];
  stats: {
    count: number;
    averageRating: number;
  };
}

const { articleSlug, comments, stats } = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;

function getInitials(name: string): string {
  const parts = name.trim().split(/\s+/);
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(date);
}

const distribution = [5, 4, 3, 2, 1].map((star) => {
  const c = comments.filter((comment) => comment.rating === star).length;
  const pct = stats.count > 0 ? Math.round((c / stats.count) * 100) : 0;
  return { star, count: c, percentage: pct };
});

const roundedRating = Math.round(stats.averageRating || 5);
---

{
  turnstileSiteKey && (
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline />
  )
}

<section
  id="comments-section"
  class="article-comments section-spacing container-site"
  data-telemetry-section="article-comments"
  data-article-slug={articleSlug}
>
  <div class="article-comments__header">
    <div class="article-comments__badge-row">
      <span class="article-comments__badge font-mono">[COMMUNITY_REVIEWS]</span>
      <span class="article-comments__badge-sub font-mono">[VERIFIED_FEEDBACK_ENGINE]</span>
    </div>
    <h2 class="article-comments__title font-display">Ulasan & Telaah Kritis Pembaca</h2>
    <p class="article-comments__lead">
      Ruang diskusi teknis, evaluasi metodologi keamanan, kritik konstruktif, dan rating dari sesama engineer dan praktisi.
    </p>
  </div>

  <!-- Executive Rating & Community Breakdown Card -->
  <div class="article-comments__summary surface-raised border-subtle">
    <div class="summary-hero">
      <div class="summary-score">
        <span class="summary-score__num font-mono" id="summary-score-num">{stats.count > 0 ? stats.averageRating.toFixed(1) : '0.0'}</span>
        <span class="summary-score__max font-mono">/ 5.0</span>
      </div>
      <div class="summary-stars-row">
        <div class="stars-display" id="summary-stars-container" role="img" aria-label={`Rating ${stats.averageRating} dari 5 bintang`}>
          {
            [1, 2, 3, 4, 5].map((i) => (
              <svg
                class={`star-svg ${i <= roundedRating ? 'star-svg--active' : 'star-svg--inactive'}`}
                viewBox="0 0 24 24"
                width="18"
                height="18"
                aria-hidden="true"
              >
                <path
                  fill="currentColor"
                  stroke="currentColor"
                  stroke-width="1.2"
                  stroke-linejoin="round"
                  d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                />
              </svg>
            ))
          }
        </div>
      </div>
      <p class="summary-count font-mono" id="reviews-count-label">
        {stats.count > 0 ? `${stats.count} telaah pembaca terverifikasi` : 'Belum ada ulasan. Jadilah pengulas pertama!'}
      </p>
    </div>

    <div class="summary-divider" aria-hidden="true"></div>

    <div class="summary-distribution" id="summary-distribution-container">
      {
        stats.count > 0 ? (
          <div class="dist-bars">
            {
              distribution.map((d) => (
                <div class="dist-row font-mono">
                  <span class="dist-star-label">{d.star} ★</span>
                  <div class="dist-track">
                    <div class="dist-fill" style={`width: ${d.percentage}%;`}></div>
                  </div>
                  <span class="dist-count">{d.count}</span>
                </div>
              ))
            }
          </div>
        ) : (
          <div class="dist-empty">
            <span class="dist-empty__tag font-mono">[OPEN_PEER_REVIEW]</span>
            <p class="dist-empty__text">
              Publikasi ini menerima umpan balik terbuka mengenai arsitektur, implementasi kontrol, atau temuan teknis terkait.
            </p>
          </div>
        )
      }
    </div>
  </div>

  <div class="article-comments__grid">
    <!-- Form Card -->
    <div class="article-comments__form-wrapper surface-raised border-subtle">
      <div class="form-header">
        <h3 class="form-heading font-display">Tulis Ulasan & Telaah</h3>
        <span class="form-sub font-mono">[INPUT_TERMINAL]</span>
      </div>

      <form id="comment-form" class="comment-form" novalidate>
        <!-- Interactive Human Star Picker -->
        <div class="comment-field">
          <div class="rating-picker-header">
            <label class="comment-label font-mono">Rating Evaluasi</label>
            <span id="star-sentiment-label" class="sentiment-badge font-mono" aria-live="polite">
              [5/5 : LUAR BIASA / SANGAT BERMANFAAT]
            </span>
          </div>

          <div
            class="star-rating-picker"
            id="star-picker-group"
            role="radiogroup"
            aria-label="Pilih rating 1 hingga 5 bintang"
            tabindex="0"
          >
            {
              [1, 2, 3, 4, 5].map((star) => (
                <button
                  type="button"
                  class="star-btn"
                  data-star-value={star}
                  role="radio"
                  aria-checked={star === 5 ? 'true' : 'false'}
                  aria-label={`${star} Bintang`}
                  title={`${star} Bintang`}
                >
                  <svg
                    class="star-picker-svg"
                    viewBox="0 0 24 24"
                    width="24"
                    height="24"
                    aria-hidden="true"
                  >
                    <path
                      fill="currentColor"
                      stroke="currentColor"
                      stroke-width="1.2"
                      stroke-linejoin="round"
                      d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                    />
                  </svg>
                </button>
              ))
            }
          </div>
          <input type="hidden" id="selected-rating" name="rating" value="5" />
          <p class="rating-helper font-mono text-xs">
            Gunakan klik atau tombol panah kiri / kanan untuk menyesuaikan skor evaluasi.
          </p>
        </div>

        <div class="comment-field">
          <label for="comment-author" class="comment-label font-mono">Nama / Identitas Anda</label>
          <input
            type="text"
            id="comment-author"
            name="authorName"
            class="comment-input font-mono"
            placeholder="Contoh: Faiz Pratama (Security Researcher)"
            required
            minlength="2"
            maxlength="50"
            autocomplete="name"
          />
          <p id="comment-author-error" class="field-error font-mono" aria-live="polite"></p>
        </div>

        <div class="comment-field">
          <label for="comment-content" class="comment-label font-mono">Ulasan / Kritik Teknis</label>
          <textarea
            id="comment-content"
            name="content"
            rows="4"
            class="comment-textarea"
            placeholder="Bagikan telaah, observasi teknis, pertanyaan implementasi, atau catatan pengujian Anda..."
            required
            minlength="3"
            maxlength="1000"
          ></textarea>
          <p id="comment-content-error" class="field-error font-mono" aria-live="polite"></p>
        </div>

        <!-- Honeypot anti-bot spam (OWASP ASVS V13) -->
        <input
          type="text"
          id="comment-honeypot"
          name="honeypot"
          tabindex="-1"
          autocomplete="off"
          style="position: absolute; left: -9999px; opacity: 0; pointer-events: none;"
          aria-hidden="true"
        />

        {
          turnstileSiteKey && (
            <div class="turnstile-container">
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark" />
            </div>
          )
        }

        <p id="comment-form-status" class="form-status font-mono" role="status" aria-live="polite"></p>

        <button type="submit" id="comment-submit-btn" class="comment-submit-btn font-mono">
          <span class="btn-text">[PUBLIKASIKAN_ULASAN]</span>
        </button>
      </form>
    </div>

    <!-- Comments List -->
    <div class="article-comments__list-wrapper">
      <div class="list-header">
        <h3 class="list-heading font-display">Semua Ulasan Pembaca</h3>
        <span class="list-badge font-mono" id="list-badge-count">[{comments.length} TERCATAT]</span>
      </div>

      <div id="comments-list" class="comments-list">
        {
          comments.length === 0 ? (
            <div id="no-comments-msg" class="no-comments surface-raised border-subtle">
              <div class="no-comments__icon font-mono">[LOG_EMPTY]</div>
              <p class="font-mono text-muted">Belum ada komentar untuk artikel ini.</p>
              <p class="font-mono text-xs text-muted mt-1">
                Gunakan formulir di samping untuk mengirimkan telaah dan rating Anda.
              </p>
            </div>
          ) : (
            comments.map((c) => (
              <article class="comment-card surface-raised border-subtle" data-comment-id={c.id}>
                <header class="comment-card__header">
                  <div class="comment-card__identity">
                    <span class="comment-card__avatar font-mono">{getInitials(c.authorName)}</span>
                    <div class="comment-card__name-col">
                      <h4 class="comment-card__author font-mono">{c.authorName}</h4>
                      <span class="comment-card__verified font-mono">[PEMBACA_TERVERIFIKASI]</span>
                    </div>
                  </div>
                  <div class="comment-card__meta">
                    <div class="comment-card__stars" role="img" aria-label={`Rating ${c.rating} dari 5 bintang`}>
                      {
                        [1, 2, 3, 4, 5].map((starIdx) => (
                          <svg
                            class={`star-svg-sm ${starIdx <= c.rating ? 'star-svg--active' : 'star-svg--inactive'}`}
                            viewBox="0 0 24 24"
                            width="14"
                            height="14"
                            aria-hidden="true"
                          >
                            <path
                              fill="currentColor"
                              stroke="currentColor"
                              stroke-width="1.2"
                              stroke-linejoin="round"
                              d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                            />
                          </svg>
                        ))
                      }
                    </div>
                    <time datetime={c.createdAt.toISOString()} class="comment-card__date font-mono">
                      {formatDate(c.createdAt)}
                    </time>
                  </div>
                </header>
                <div class="comment-card__content-box">
                  <p class="comment-card__body">{c.content}</p>
                </div>
              </article>
            ))
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  const SENTIMENT_MAP: Record<number, string> = {
    1: '[1/5 : KURANG MEMUASKAN]',
    2: '[2/5 : PERLU PENDALAMAN]',
    3: '[3/5 : CUKUP INFORMATIF]',
    4: '[4/5 : SANGAT BAGUS & RELEVAN]',
    5: '[5/5 : LUAR BIASA / SANGAT BERMANFAAT]',
  };

  function createStarSvg(active: boolean, size = 14): string {
    return `<svg class="star-svg-sm ${active ? 'star-svg--active' : 'star-svg--inactive'}" viewBox="0 0 24 24" width="${size}" height="${size}" aria-hidden="true"><path fill="currentColor" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`;
  }

  function renderStarsHtml(ratingVal: number, size = 18): string {
    const rounded = Math.round(ratingVal || 0);
    let html = '';
    for (let i = 1; i <= 5; i++) {
      const active = i <= rounded;
      html += `<svg class="star-svg ${active ? 'star-svg--active' : 'star-svg--inactive'}" viewBox="0 0 24 24" width="${size}" height="${size}" aria-hidden="true"><path fill="currentColor" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`;
    }
    return html;
  }

  function getInitialsJs(name: string): string {
    const parts = name.trim().split(/\s+/);
    if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
    return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
  }

  function escapeHtmlJs(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function updateSummaryStats(stats: { count: number; averageRating: number; distribution?: Array<{ star: number; count: number; percentage: number }> }) {
    const scoreNum = document.getElementById('summary-score-num');
    if (scoreNum) {
      scoreNum.textContent = stats.count > 0 ? stats.averageRating.toFixed(1) : '0.0';
    }

    const starsContainer = document.getElementById('summary-stars-container');
    if (starsContainer) {
      starsContainer.setAttribute('aria-label', `Rating ${stats.averageRating} dari 5 bintang`);
      starsContainer.innerHTML = renderStarsHtml(stats.averageRating, 18);
    }

    const countLabel = document.getElementById('reviews-count-label');
    if (countLabel) {
      countLabel.textContent = stats.count > 0 ? `${stats.count} telaah pembaca terverifikasi` : 'Belum ada ulasan. Jadilah pengulas pertama!';
    }

    const listBadge = document.getElementById('list-badge-count');
    if (listBadge) {
      listBadge.textContent = `[${stats.count} TERCATAT]`;
    }

    if (stats.distribution && stats.distribution.length > 0) {
      const distContainer = document.getElementById('summary-distribution-container');
      if (distContainer) {
        if (stats.count > 0) {
          let barsHtml = '<div class="dist-bars">';
          stats.distribution.forEach((d) => {
            barsHtml += `
              <div class="dist-row font-mono">
                <span class="dist-star-label">${d.star} ★</span>
                <div class="dist-track">
                  <div class="dist-fill" style="width: ${d.percentage}%;"></div>
                </div>
                <span class="dist-count">${d.count}</span>
              </div>
            `;
          });
          barsHtml += '</div>';
          distContainer.innerHTML = barsHtml;
        }
      }
    }
  }

  function initComments() {
    const section = document.getElementById('comments-section');
    if (!section) return;

    const articleSlug = section.getAttribute('data-article-slug');
    if (!articleSlug) return;

    const form = document.getElementById('comment-form') as HTMLFormElement | null;
    if (!form) return;

    if (form.dataset.commentsInitialized === 'true') {
      return;
    }
    form.dataset.commentsInitialized = 'true';

    // Pastikan Turnstile ter-render pada SPA client transitions jika container kosong
    if (typeof window !== 'undefined' && (window as any).turnstile) {
      const turnstileContainer = form.querySelector('.cf-turnstile');
      if (turnstileContainer && !turnstileContainer.hasChildNodes()) {
        try {
          (window as any).turnstile.render(turnstileContainer);
        } catch {
          // ignore
        }
      }
    }

    const starPickerGroup = document.getElementById('star-picker-group');
    const starButtons = section.querySelectorAll<HTMLButtonElement>('.star-btn');
    const ratingInput = document.getElementById('selected-rating') as HTMLInputElement | null;
    const sentimentLabel = document.getElementById('star-sentiment-label');
    const authorInput = document.getElementById('comment-author') as HTMLInputElement | null;
    const contentInput = document.getElementById('comment-content') as HTMLTextAreaElement | null;
    const honeypotInput = document.getElementById('comment-honeypot') as HTMLInputElement | null;
    const authorError = document.getElementById('comment-author-error');
    const contentError = document.getElementById('comment-content-error');
    const statusMsg = document.getElementById('comment-form-status');
    const submitBtn = document.getElementById('comment-submit-btn') as HTMLButtonElement | null;
    const commentsList = document.getElementById('comments-list');
    const noCommentsMsg = document.getElementById('no-comments-msg');

    let isSubmitting = false;
    let selectedRating = 5;

    function renderStarPickerState(activeVal: number) {
      starButtons.forEach((btn) => {
        const btnVal = Number(btn.getAttribute('data-star-value'));
        if (btnVal <= activeVal) {
          btn.classList.add('star-btn--active');
        } else {
          btn.classList.remove('star-btn--active');
        }
      });
    }

    function applySelectedRating(val: number) {
      selectedRating = Math.min(Math.max(val, 1), 5);
      if (ratingInput) ratingInput.value = String(selectedRating);

      renderStarPickerState(selectedRating);
      starButtons.forEach((btn) => {
        const btnVal = Number(btn.getAttribute('data-star-value'));
        btn.setAttribute('aria-checked', btnVal === selectedRating ? 'true' : 'false');
      });

      if (sentimentLabel) {
        sentimentLabel.textContent = SENTIMENT_MAP[selectedRating] || `[${selectedRating}/5]`;
      }
    }

    // Inisialisasi default 5 bintang
    applySelectedRating(5);

    // Hover preview dan click tactile feedback
    starButtons.forEach((btn) => {
      const val = Number(btn.getAttribute('data-star-value')) || 5;

      btn.addEventListener('mouseenter', () => {
        renderStarPickerState(val);
        if (sentimentLabel) {
          sentimentLabel.textContent = SENTIMENT_MAP[val] || `[${val}/5]`;
        }
      });

      btn.addEventListener('click', () => {
        applySelectedRating(val);
      });
    });

    if (starPickerGroup) {
      starPickerGroup.addEventListener('mouseleave', () => {
        applySelectedRating(selectedRating);
      });

      // Dukungan keyboard aksesibel: Arrow Left/Right, 1-5
      starPickerGroup.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
          e.preventDefault();
          applySelectedRating(Math.min(selectedRating + 1, 5));
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
          e.preventDefault();
          applySelectedRating(Math.max(selectedRating - 1, 1));
        } else if (['1', '2', '3', '4', '5'].includes(e.key)) {
          applySelectedRating(Number(e.key));
        }
      });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (isSubmitting) return;

      if (authorError) authorError.textContent = '';
      if (contentError) contentError.textContent = '';
      if (statusMsg) {
        statusMsg.textContent = '';
        statusMsg.removeAttribute('data-state');
      }

      const author = authorInput?.value.trim() ?? '';
      const content = contentInput?.value.trim() ?? '';
      const rating = Number(ratingInput?.value) || selectedRating || 5;
      const honeypot = honeypotInput?.value ?? '';

      let hasError = false;
      if (author.length < 2) {
        if (authorError) authorError.textContent = 'Nama minimal 2 karakter';
        hasError = true;
      }
      if (content.length < 3) {
        if (contentError) contentError.textContent = 'Komentar minimal 3 karakter';
        hasError = true;
      }
      if (hasError) return;

      let turnstileToken = '';
      const turnstileInput = form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]');
      if (turnstileInput) turnstileToken = turnstileInput.value;

      isSubmitting = true;
      if (submitBtn) {
        submitBtn.disabled = true;
        const textSpan = submitBtn.querySelector('.btn-text');
        if (textSpan) textSpan.textContent = 'MENGIRIM...';
      }

      try {
        const res = await fetch(`/api/public/articles/${encodeURIComponent(articleSlug)}/comments`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            authorName: author,
            content,
            rating,
            honeypot,
            turnstileToken,
          }),
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok) {
          if (res.status === 429) {
            if (statusMsg) {
              statusMsg.textContent = 'Terlalu banyak permintaan. Silakan tunggu beberapa menit.';
              statusMsg.setAttribute('data-state', 'error');
            }
          } else if (data.fields) {
            if (data.fields.authorName && authorError) authorError.textContent = data.fields.authorName[0];
            if (data.fields.content && contentError) contentError.textContent = data.fields.content[0];
          } else {
            if (statusMsg) {
              statusMsg.textContent = data.error ?? 'Gagal mengirim ulasan.';
              statusMsg.setAttribute('data-state', 'error');
            }
          }
          if (typeof window !== 'undefined' && (window as any).turnstile) {
            try {
              (window as any).turnstile.reset();
            } catch {
              // ignore
            }
          }
          return;
        }

        // Sukses
        if (statusMsg) {
          statusMsg.textContent = '✓ Ulasan Anda berhasil diterbitkan!';
          statusMsg.setAttribute('data-state', 'success');
        }

        form.reset();
        applySelectedRating(5);

        if (typeof window !== 'undefined' && (window as any).turnstile) {
          try {
            (window as any).turnstile.reset();
          } catch {
            // ignore
          }
        }

        if (noCommentsMsg) noCommentsMsg.remove();

        if (data.comment && commentsList) {
          const commentId = String(data.comment.id);
          const alreadyExists = commentsList.querySelector(`[data-comment-id="${commentId}"]`);
          if (!alreadyExists) {
            const card = document.createElement('article');
            card.className = 'comment-card surface-raised border-subtle';
            card.setAttribute('data-comment-id', commentId);
            const fullStars = Math.min(Math.max(data.comment.rating, 1), 5);

            let starsMarkup = '';
            for (let s = 1; s <= 5; s++) {
              starsMarkup += createStarSvg(s <= fullStars);
            }

            const initials = getInitialsJs(data.comment.authorName);

            card.innerHTML = `
              <header class="comment-card__header">
                <div class="comment-card__identity">
                  <span class="comment-card__avatar font-mono">${initials}</span>
                  <div class="comment-card__name-col">
                    <h4 class="comment-card__author font-mono">${escapeHtmlJs(data.comment.authorName)}</h4>
                    <span class="comment-card__verified font-mono">[PEMBACA_TERVERIFIKASI]</span>
                  </div>
                </div>
                <div class="comment-card__meta">
                  <div class="comment-card__stars" role="img" aria-label="Rating ${data.comment.rating} dari 5 bintang">
                    ${starsMarkup}
                  </div>
                  <time class="comment-card__date font-mono">Baru saja</time>
                </div>
              </header>
              <div class="comment-card__content-box">
                <p class="comment-card__body">${escapeHtmlJs(data.comment.content)}</p>
              </div>
            `;
            commentsList.prepend(card);
          }
        }

        if (data.stats) {
          updateSummaryStats(data.stats);
        }
      } catch {
        if (statusMsg) {
          statusMsg.textContent = 'Terjadi kesalahan jaringan. Coba lagi nanti.';
          statusMsg.setAttribute('data-state', 'error');
        }
        if (typeof window !== 'undefined' && (window as any).turnstile) {
          try {
            (window as any).turnstile.reset();
          } catch {
            // ignore
          }
        }
      } finally {
        isSubmitting = false;
        if (submitBtn) {
          submitBtn.disabled = false;
          const textSpan = submitBtn.querySelector('.btn-text');
          if (textSpan) textSpan.textContent = '[PUBLIKASIKAN_ULASAN]';
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initComments);
</script>

<style>
  .article-comments {
