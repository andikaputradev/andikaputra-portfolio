---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ProjectDetailView from '../../../../components/work/ProjectDetailView.astro';
import { db } from '../../../../db';
import { projects } from '../../../../db/schema';
import { eq } from 'drizzle-orm';
import { resolveProjectView } from '../../../../lib/project-draft';

export const prerender = false;

const id = Number(Astro.params.id);
if (!Number.isInteger(id)) {
  return Astro.redirect('/admin/projects');
}

const [project] = await db.select().from(projects).where(eq(projects.id, id));
if (!project) {
  return Astro.redirect('/admin/projects');
}

const hasDraft = Boolean(project.draftData);
const viewData = resolveProjectView(project);
---

<BaseLayout
  title={`[Pratinjau] ${viewData.title}`}
  description={viewData.summary}
  noindex={true}
>
  <div class="preview-banner mono">
    MODE PRATINJAU — {hasDraft ? 'menampilkan draft belum dipublikasikan' : 'menampilkan versi live saat ini'}
    <a href={`/admin/projects/${project.id}/edit`}>Kembali ke form edit</a>
  </div>
  <main id="main-content">
    <ProjectDetailView project={viewData} showBackLink={false} />
  </main>
</BaseLayout>

<style>
  .preview-banner {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 0.75rem 1rem;
    background-color: var(--color-accent-phosphor);
    color: var(--color-bg);
    font-size: 0.8rem;
    text-align: center;
  }

  .preview-banner a {
    color: var(--color-bg);
    text-decoration: underline;
  }
</style>
