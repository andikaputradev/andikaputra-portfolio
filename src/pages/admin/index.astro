---
import AdminLayout from '../../layouts/AdminLayout.astro';
import StatCard from '../../components/admin/StatCard.astro';
import RevenueChart from '../../components/admin/RevenueChart.astro';
import TransactionTable from '../../components/admin/TransactionTable.astro';
import GaugeChart from '../../components/admin/GaugeChart.astro';
import { db } from '../../db';
import { projects, articles, certifications, auditLog } from '../../db/schema';
import { desc, count, eq } from 'drizzle-orm';
import { getVisitorSummary } from '../../lib/visitor-stats';

export const prerender = false;

const [projectCount] = await db.select({ value: count() }).from(projects);
const [publishedProjectCount] = await db
  .select({ value: count() })
  .from(projects)
  .where(eq(projects.published, true));
const [articleCount] = await db.select({ value: count() }).from(articles);
const [publishedArticleCount] = await db
  .select({ value: count() })
  .from(articles)
  .where(eq(articles.published, true));
const [certCount] = await db.select({ value: count() }).from(certifications);
const recentActivity = await db.select().from(auditLog).orderBy(desc(auditLog.createdAt)).limit(8);
const visitorSummary = await getVisitorSummary(7);

// Generate dummy data for RevenueChart (views over last 7 days)
// Real implementation would group pageViews by date
const chartLabels = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const chartData = [120, 190, 150, 220, 180, 250, visitorSummary.totalViews];

const projectCompletionRate = projectCount.value > 0 ? Math.round((publishedProjectCount.value / projectCount.value) * 100) : 0;
const articleCompletionRate = articleCount.value > 0 ? Math.round((publishedArticleCount.value / articleCount.value) * 100) : 0;
---

<AdminLayout title="Overview Dashboard" breadcrumb="Dashboard">
  <Fragment slot="actions">
    <div class="flex items-center gap-3">
      <button class="px-4 py-2 rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white transition-colors text-sm font-medium border border-slate-700 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
        Export
      </button>
      <button class="px-4 py-2 rounded-lg bg-cyan-500 text-slate-900 hover:bg-cyan-400 transition-colors text-sm font-bold shadow-[0_0_15px_rgba(6,182,212,0.4)] flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
        New Item
      </button>
    </div>
  </Fragment>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <StatCard 
      label="Total Views (7d)" 
      value={visitorSummary.totalViews} 
      trend={12.5} 
      color="cyan"
      icon='<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>'
    />
    <StatCard 
      label="Projects" 
      value={projectCount.value} 
      trend={0} 
      color="purple"
      icon='<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>'
    />
    <StatCard 
      label="Articles" 
      value={articleCount.value} 
      trend={5.2} 
      color="orange"
      icon='<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>'
    />
    <StatCard 
      label="Certifications" 
      value={certCount.value} 
      color="green"
      icon='<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>'
    />
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
    <div class="lg:col-span-2">
      <RevenueChart data={chartData} labels={chartLabels} />
    </div>
    <div class="space-y-6">
      <GaugeChart label="Projects Published" value={projectCompletionRate} />
      <GaugeChart label="Articles Published" value={articleCompletionRate} />
    </div>
  </div>

  <div class="mt-6">
    <TransactionTable activities={recentActivity} />
  </div>
</AdminLayout>
