---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { db } from '../../db';
import { articles, articleComments } from '../../db/schema';
import { and, eq, desc } from 'drizzle-orm';
import { getEntry, render } from 'astro:content';
import { renderProjectBody } from '../../lib/render-markdown';
import { cloudinaryImageUrl, cloudinarySrcSet } from '../../lib/cloudinary-url';
import { trackVisit } from '../../lib/track-visit';
import { buildArticleSchema, buildBreadcrumbSchema } from '../../lib/json-ld';
import { extractHeadings } from '../../lib/article-toc';
import { countWords, calculateReadingTime } from '../../lib/reading-time';
import { getRelatedArticles } from '../../lib/related-articles';
import TableOfContents from '../../components/article/TableOfContents.astro';
import ArticleComments from '../../components/article/ArticleComments.astro';
import Image from '../../components/mdx/Image.astro';
import Blockquote from '../../components/mdx/Blockquote.astro';
import Table from '../../components/mdx/Table.astro';

export const prerender = false;

const slug = Astro.params.slug;
if (!slug) {
  return Astro.rewrite('/404');
}

const [article] = await db
  .select()
  .from(articles)
  .where(and(eq(articles.slug, slug), eq(articles.published, true)));

if (!article) {
  return Astro.rewrite('/404');
}

trackVisit(Astro.request, `/artikel/${article.slug}`);

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const siteUrl = Astro.site?.toString() ?? 'https://wahyuandikaputra.my.id/';
const cleanSiteUrl = siteUrl.endsWith('/') ? siteUrl : `${siteUrl}/`;

// Hitung statistik artikel & daftar isi otomatis
const headings = extractHeadings(article.bodyMarkdown);
const wordCount = countWords(article.bodyMarkdown);
const readingTime = article.readingTimeMinutes || calculateReadingTime(article.bodyMarkdown);
const bodyHtml = renderProjectBody(article.bodyMarkdown, { withHeadingIds: true });

// MDX Content Collection resolution
const mdxEntry = await getEntry('articles', slug);
const mdxRendered = mdxEntry ? await render(mdxEntry) : null;
const MDXContent = mdxRendered ? mdxRendered.Content : null;

const coverSrc = article.coverImagePublicId
  ? cloudinaryImageUrl(article.coverImagePublicId, 'f_auto,q_auto,w_1200')
  : null;
const coverSrcSet = article.coverImagePublicId
  ? cloudinarySrcSet(article.coverImagePublicId, [480, 768, 1024, 1400])
  : undefined;

let rawComments: Array<{
  id: number;
  authorName: string;
  rating: number;
  content: string;
  createdAt: Date;
}> = [];

let allPublishedArticles: Array<any> = [];

try {
  const [commentsResult, articlesResult] = await Promise.all([
    db
      .select({
        id: articleComments.id,
        authorName: articleComments.authorName,
        rating: articleComments.rating,
        content: articleComments.content,
        createdAt: articleComments.createdAt,
      })
      .from(articleComments)
      .where(and(eq(articleComments.articleId, article.id), eq(articleComments.approved, true)))
      .orderBy(desc(articleComments.createdAt)),
    db
      .select({
        id: articles.id,
        slug: articles.slug,
        title: articles.title,
        category: articles.category,
        summary: articles.summary,
        coverImagePublicId: articles.coverImagePublicId,
        tags: articles.tags,
        readingTimeMinutes: articles.readingTimeMinutes,
        published: articles.published,
        displayOrder: articles.displayOrder,
        publishedAt: articles.publishedAt,
      })
      .from(articles)
      .where(eq(articles.published, true)),
  ]);
  rawComments = commentsResult;
  allPublishedArticles = articlesResult;
} catch (error) {
  console.error('Gagal mengambil data artikel/komentar:', error instanceof Error ? error.message : error);
}

const commentsCount = rawComments.length;

const avgRating =
  commentsCount > 0
    ? Number((rawComments.reduce((acc, c) => acc + c.rating, 0) / commentsCount).toFixed(1))
    : 0;

const CATEGORY_LABELS: Record<string, string> = {
  SECURITY: 'Security',
  WEB3: 'Web3',
  WEBDEV: 'Web Dev',
  GENERAL: 'General',
};

const publishedDate = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(article.publishedAt);

const articleUrl = `${cleanSiteUrl}artikel/${article.slug}/`;

const articleSchema = buildArticleSchema(
  {
    ...article,
    wordCount,
    ogImageOverride: article.ogImageOverride,
  },
  siteUrl,
  commentsCount > 0 ? { ratingValue: avgRating, reviewCount: commentsCount } : undefined,
);

const breadcrumbSchema = buildBreadcrumbSchema(
  [
    { name: 'Home', url: '/' },
    { name: 'Artikel', url: 'artikel/' },
    { name: article.title, url: `artikel/${article.slug}/` },
  ],
  siteUrl,
);

const relatedArticles = getRelatedArticles(article, allPublishedArticles as any, 3);

const whatsappText = encodeURIComponent(`Baca artikel ini: ${article.title} ${articleUrl}`);
const twitterText = encodeURIComponent(`${article.title} ${articleUrl}`);
const linkedInUrl = encodeURIComponent(articleUrl);
const canonicalUrl = article.canonicalUrlOverride || articleUrl;
const ogImage = article.ogImageOverride || coverSrc || `/og/${article.slug}.png`;
---

<BaseLayout
  title={article.metaTitle || `${article.title} | Wahyu Andika Putra`}
  description={article.metaDescription || article.summary}
  canonical={canonicalUrl}
  ogImage={ogImage}
  ogType="article"
  additionalSchemas={[articleSchema, breadcrumbSchema]}
  keywords={article.tags ?? []}
  lang="id"
  preloadImage={coverSrc ?? undefined}
  preloadImageSrcSet={coverSrcSet ?? undefined}
>
  <main id="main-content">
    <article class="article-detail">
      <header class="article-detail__header container-site">
        <a href="/artikel/" class="article-detail__back">← Kembali ke artikel</a>
        <span class={`article-card__category font-mono article-card__category--${article.category.toLowerCase()}`}>
          [{CATEGORY_LABELS[article.category] ?? article.category}]
        </span>
        <h1 class="article-detail__title font-display">{article.title}</h1>
        <div class="article-detail__meta font-mono">
          <time datetime={article.publishedAt.toISOString()}>{publishedDate}</time>
          <span class="article-detail__separator">·</span>
          <span>{wordCount.toLocaleString('id-ID')} kata</span>
          <span class="article-detail__separator">·</span>
          <span>{readingTime} min read</span>
        </div>
      </header>

      {coverSrc && (
        <div class="article-detail__cover-wrap container-site">
          <img
            src={coverSrc}
            srcset={coverSrcSet}
            sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1200px"
            width="1200"
            height="675"
            alt={`${article.title} cover`}
            class="article-detail__cover"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      )}

      <div class="article-detail__body container-site">
        <TableOfContents headings={headings} />
        <div class="prose prose-invert max-w-none article-detail__content">
          {MDXContent ? (
            <MDXContent components={{ img: Image, blockquote: Blockquote, table: Table }} />
          ) : (
            <div set:html={bodyHtml} />
          )}
        </div>
      </div>

      <div class="article-detail__sharing container-site">
        <p class="article-detail__sharing-label font-mono">Share artikel ini:</p>
        <div class="article-detail__sharing-links">
          <a
            href={`https://wa.me/?text=${whatsappText}`}
            target="_blank"
            rel="noopener noreferrer"
            class="article-detail__share-link"
          >
            WhatsApp
          </a>
          <a
            href={`https://twitter.com/intent/tweet?text=${twitterText}`}
            target="_blank"
            rel="noopener noreferrer"
            class="article-detail__share-link"
          >
            Twitter
          </a>
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${linkedInUrl}`}
            target="_blank"
            rel="noopener noreferrer"
            class="article-detail__share-link"
          >
            LinkedIn
          </a>
        </div>
      </div>

      <ArticleComments
        articleId={article.id}
        articleSlug={article.slug}
        comments={rawComments}
        stats={{ count: commentsCount, averageRating: avgRating }}
      />

      <section class="section-spacing container-site">
        <div class="article-detail__related-top">
          <h2 class="article-detail__related-heading font-display">Artikel Terkait</h2>
          <a href="/artikel/" class="article-detail__related-all font-mono">Lihat Semua →</a>
        </div>
        <div class="article-detail__related">
          {relatedArticles.length > 0 ? (
            <div class="article-detail__related-grid">
              {relatedArticles.map((rel) => (
                <article class="article-card">
                  <a href={`/artikel/${rel.slug}/`} class="article-card__link">
                    <div class="article-card__header font-mono">
                      <span class={`article-card__category article-card__category--${rel.category.toLowerCase()}`}>
                        [{CATEGORY_LABELS[rel.category] ?? rel.category}]
                      </span>
                      <span class="article-card__reading-time">{rel.readingTimeMinutes ?? 5} min read</span>
                    </div>
                    <h3 class="article-card__title font-display">{rel.title}</h3>
                    <p class="article-card__summary">{rel.summary}</p>
                    <div class="article-card__meta font-mono">
                      <time datetime={rel.publishedAt.toISOString()}>
                        {new Intl.DateTimeFormat('id-ID', {
                          day: 'numeric',
                          month: 'short',
                          year: 'numeric',
                          timeZone: 'UTC',
                        }).format(rel.publishedAt)}
                      </time>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          ) : (
            <div class="article-detail__related-fallback">
              <p class="font-mono text-muted">Jelajahi analisis teknis, keamanan siber, dan riset protokol Web3 lainnya.</p>
              <a href="/artikel/" class="article-detail__share-link font-mono">Kunjungi Arsip Artikel</a>
            </div>
          )}
        </div>
      </section>
    </article>
  </main>
</BaseLayout>

<style>
  .article-detail__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: 2rem;
  }

  .article-detail__back {
    font-family: var(--font-mono), monospace;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .article-detail__back:hover {
    color: var(--color-accent-phosphor);
  }

  .article-card__category {
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    width: fit-content;
  }

  .article-card__category--security {
    color: var(--color-accent-phosphor);
    border-color: color-mix(in oklch, var(--color-accent-phosphor) 40%, transparent);
  }

  .article-card__category--web3 {
    color: var(--color-accent-steel);
    border-color: color-mix(in oklch, var(--color-accent-steel) 40%, transparent);
  }

  .article-card__category--webdev {
    color: #a78bfa;
    border-color: color-mix(in oklch, #a78bfa 40%, transparent);
  }

  .article-card__category--general {
    color: var(--color-text-muted);
  }

  .article-detail__title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.1;
    max-width: 28ch;
    letter-spacing: -0.02em;
  }

  .article-detail__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .article-detail__separator {
    opacity: 0.4;
  }

  .article-detail__cover-wrap {
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .article-detail__cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background-color: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }

  .article-detail__body {
    max-width: 68ch;
    padding-bottom: 2rem;
  }

  .article-detail__content {
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .article-detail__content :global(p + p) {
    margin-top: 1.25rem;
  }

  .article-detail__content :global(h2) {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    scroll-margin-top: 5rem;
  }

  .article-detail__content :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 5rem;
  }

  .article-detail__content :global(pre) {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    overflow-x: auto;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .article-detail__content :global(code) {
    font-family: var(--font-mono), monospace;
    font-size: 0.9em;
  }

  .article-detail__content :global(:not(pre) > code) {
    background-color: var(--color-surface);
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .article-detail__content :global(blockquote) {
    border-left: 3px solid var(--color-accent-phosphor);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .article-detail__content :global(ul),
  .article-detail__content :global(ol) {
    padding-left: 1.5rem;
    margin: 1rem 0;
  }

  .article-detail__content :global(li + li) {
    margin-top: 0.35rem;
  }

  .article-detail__content :global(a) {
    color: var(--color-accent-phosphor);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition-fast);
  }

  .article-detail__content :global(a:hover) {
    color: var(--color-text-primary);
  }

  .article-detail__content :global(strong) {
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .article-detail__sharing {
    padding-block: 2rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--spacing-section);
  }

  .article-detail__sharing-label {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .article-detail__sharing-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .article-detail__share-link {
    font-size: 0.875rem;
    font-family: var(--font-mono), monospace;
    color: var(--color-accent-phosphor);
    text-decoration: none;
    padding: 0.45rem 1rem;
    border: 1px solid color-mix(in oklch, var(--color-accent-phosphor) 40%, transparent);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .article-detail__share-link:hover {
    background-color: color-mix(in oklch, var(--color-accent-phosphor) 10%, transparent);
    border-color: var(--color-accent-phosphor);
  }

  .article-detail__related-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .article-detail__related-heading {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .article-detail__related-all {
    font-size: 0.8125rem;
    color: var(--color-accent-phosphor);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .article-detail__related-all:hover {
    color: var(--color-text-primary);
  }

  .article-detail__related-fallback {
    padding: 2.5rem;
    text-align: center;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .article-detail__related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .article-detail__related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .article-detail__related-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .article-card {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .article-card__link {
    display: flex;
    flex-direction: column;
    flex: 1;
    text-decoration: none;
    color: inherit;
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
    box-shadow: var(--shadow-sm);
  }

  .article-card__link:hover {
    border-color: color-mix(in oklch, var(--color-accent-phosphor) 30%, var(--color-border));
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .article-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .article-card__reading-time {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  .article-card__title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.3;
    margin-bottom: 0.75rem;
    transition: color var(--transition-fast);
  }

  .article-card__link:hover .article-card__title {
    color: var(--color-accent-phosphor);
  }

  .article-card__summary {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    flex: 1;
    margin-bottom: 1.25rem;
  }

  .article-card__meta {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border);
  }
</style>
